rules_version = '2';

// OpenBuildOS workspace-project security rules.
//
// MODEL OPRÁVNĚNÍ (#506, fáze 2): role není stupeň na škále, ale POJMENOVANÁ
// KOMBINACE nezávislých oprávnění `read` · `contribute` · `edit` · `certify` ·
// `publish` · `manage`. Vstupní bod je helper `hasPerm()` níž; nic jiného už
// nesmí rozhodovat podle názvu role. Klientské zrcadlo modelu žije v
// `src/lib/permissions/projectPermissions.ts`.
//
// Membership source of truth lives on the top-level /projects/{pid} document:
//   { workspaceId: string, memberIds: string[], roles: { [uid]: reader|viewer|editor|admin } }
// Workspace-level admins live on /workspaces/{wid}: { ownerId, adminIds }.
// Invites are bearer tokens under /workspaces/{wid}/invites/{inviteId} and are
// redeemed atomically (invite claim + members doc + project membership arrays
// in a single batch enforced via getAfter()).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    // Stabilní federovaný subjekt napříč per-firma Firebase projekty.
    // Firebase přiděluje JINÉ request.auth.uid v každém projektu pro téhož
    // OIDC uživatele, takže membership/autorizace musí klíčovat federovaným
    // subjektem, ne uid. Pokud token nese identitu z provideru
    // 'oidc.openbuildos' (neprázdný list), vrátíme její první prvek; jinak
    // (dev e-mail/heslo, anonymous, … žádné identities) fallback na uid.
    // Pozn.: rules nemají snadné `in` na klíče mapy, proto čteme přes
    // .get('identities', {}).get('oidc.openbuildos', []) a kontrolujeme size().
    function principal() {
      return request.auth.token.firebase
          .get('identities', {})
          .get('oidc.openbuildos', []).size() > 0
        ? request.auth.token.firebase.identities['oidc.openbuildos'][0]
        : request.auth.uid;
    }

    function wsPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid);
    }

    function wsData(wid) {
      return get(wsPath(wid)).data;
    }

    function isWsOwner(wid) {
      return isRealUser()
        && exists(wsPath(wid))
        && wsData(wid).get('ownerId', '') == principal();
    }

    function isWsAdmin(wid) {
      return isRealUser()
        && exists(wsPath(wid))
        && (wsData(wid).get('ownerId', '') == principal()
            || principal() in wsData(wid).get('adminIds', []));
    }

    function projectPath(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    function projectData(pid) {
      return get(projectPath(pid)).data;
    }

    function projectInWorkspace(wid, pid) {
      return exists(projectPath(pid))
        && projectData(pid).get('workspaceId', '') == wid;
    }

    function projectRole(pid) {
      return projectData(pid).get('roles', {}).get(principal(), '');
    }

    function isProjectMember(wid, pid) {
      return isRealUser()
        && projectInWorkspace(wid, pid)
        && (principal() in projectData(pid).get('memberIds', [])
            || isWsAdmin(wid));
    }

    // ---------------------------------------------------------------------
    // MODEL OPRÁVNĚNÍ (#506, fáze 2) — skládaná MNOŽINA, ne žebříček
    //
    // Dosud byla role stupeň na škále: kdo chtěl vyšší úkon, musel mít i
    // všechna nižší práva. Kvůli tomu KONTROLNÍ role nemohla provést KONTROLNÍ
    // ÚKON — TDI/projektant, který má jen schvalovat, potřeboval editační právo
    // k cizímu obsahu, jinak mu pravidla odmítla ověření úkolu (a povýšení
    // schváleného výkresu do Plánů).
    //
    //   read       vidí projekt (= členství; nikdy se neodebírá)
    //   contribute zakládá VLASTNÍ obsah a mění JEN svůj
    //   edit       mění CIZÍ obsah
    //   certify    schvaluje revize dokumentů a ověřuje úkoly (verified)
    //   publish    vydává do OFICIÁLNÍ dokumentace
    //   manage     spravuje členy a nastavení projektu
    //
    // 🔑 `certify` NEVYŽADUJE `edit`. To je celý smysl přestavby.
    //
    // Zdroje: role z `projects/{pid}.roles[principal]` (jediný zdroj, který
    // vynucují pravidla) + dva ORTOGONÁLNÍ flagy ze zrcadla členů
    // (`canApprove` → certify, `canPublishOfficial` → publish). Vlastník/admin
    // firmy má na svých projektech vše.
    //
    // ⚠️ ZRCADLO tohohle modelu na klientu je `src/lib/permissions/projectPermissions.ts`.
    // Když měníš jedno, měň obojí — a přidej rules test do tests/rules/firestore.permissions.test.ts.
    // ---------------------------------------------------------------------

    // Migrační tabulka role → množina oprávnění (#506: „nikomu nic nevezme").
    //
    // ⚠️ `editor` má i `publish`: do #506 publikoval do oficiální dokumentace
    // IMPLICITNĚ (helper `canPublishOfficial` = `canEditContent || flag`).
    // Odebrat mu to by rozbilo hlavní cestu nahrávání dokumentů.
    //
    // 🪦 `company_lead` je ZRUŠENÁ role (#506) — nově ji nejde přiřadit (chybí
    // v allowlistu zrcadla členů níž). Tabulka ji drží JEN kvůli existujícím
    // datům v `projects/{pid}.roles`, ať o práva nepřijde nikdo, komu se do dat
    // dostala. Migrace dle zadání: read + contribute + edit.
    //
    // Neznámá / chybějící role se chová jako `viewer` — přesně jako dosud
    // (`canCreateContent` stálo na pouhém členství). Fail-safe DOLŮ nejdeme:
    // členovi s legacy hodnotou v `roles` bychom vzali zakládání obsahu.
    function rolePermissions(role) {
      return role == 'admin'
          ? ['read', 'contribute', 'edit', 'certify', 'publish', 'manage']
        : role == 'editor'
          ? ['read', 'contribute', 'edit', 'publish']
        : role == 'company_lead'
          ? ['read', 'contribute', 'edit']
        : role == 'reader'
          ? ['read']
        : ['read', 'contribute'];
    }

    function memberMirrorPath(wid, pid) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/members/$(principal());
    }

    // Ortogonální oprávnění z flagů na zrcadle členů. `exists()` je tu schválně:
    // bez něj by `get()` na chybějící dokument byl chybový výraz a jeho
    // vyhodnocení by záviselo na pořadí větví v `||`. Cesta se v rámci requestu
    // cachuje, takže je to nejvýš jedno čtení navíc.
    function memberFlagPermissions(wid, pid) {
      return exists(memberMirrorPath(wid, pid))
        ? (get(memberMirrorPath(wid, pid)).data.get('canApprove', false) == true
             ? ['certify'] : [])
          .concat(get(memberMirrorPath(wid, pid)).data.get('canPublishOfficial', false) == true
             ? ['publish'] : [])
        : [];
    }

    // 🔴 VÝKONNOSTNÍ MEZ: Firestore vyhodnotí nejvýš 1000 výrazů na požadavek.
    // Množina se proto počítá JEDNOU a dál se PŘEDÁVÁ jako seznam
    // (`hasAny([...])`), místo aby se pro každé oprávnění volal zvlášť gate.
    // Naivní varianta (`canEdit() || canCertify() || canPublish()`) ten strop
    // přerazila hned u prvního složeného pravidla — a selhala jako
    // permission-denied, tedy k nerozeznání od chybějícího práva.
    function permsOf(wid, pid) {
      return isProjectMember(wid, pid)
        ? (isWsAdmin(wid)
            ? ['read', 'contribute', 'edit', 'certify', 'publish', 'manage']
            : rolePermissions(projectRole(pid)).concat(memberFlagPermissions(wid, pid)))
        : [];
    }

    // Jednorázová kontrola jednoho oprávnění. Pro pravidla, která jich testují
    // víc, si vyzvedni seznam přes `permsOf()` a předej ho dál.
    function hasPerm(wid, pid, perm) {
      return permsOf(wid, pid).hasAny([perm]);
    }

    function canContribute(wid, pid) {
      return hasPerm(wid, pid, 'contribute');
    }

    function canEdit(wid, pid) {
      return hasPerm(wid, pid, 'edit');
    }

    function canCertify(wid, pid) {
      return hasPerm(wid, pid, 'certify');
    }

    function canPublish(wid, pid) {
      return hasPerm(wid, pid, 'publish');
    }

    function canManage(wid, pid) {
      return hasPerm(wid, pid, 'manage');
    }

    // Bootstrap-friendly variant: also lets admins create a project and its
    // members docs in one atomic batch. The post-state branch only applies
    // when the project doc did NOT exist before the batch -- in that case the
    // batched /projects create was itself validated (workspace admin with
    // roles[uid] == 'admin'). For pre-existing projects only the pre-state
    // role counts, so an invite redeem cannot escalate itself to admin.
    function canManageAfter(wid, pid) {
      return canManage(wid, pid)
        || (isRealUser()
            && !exists(projectPath(pid))
            && getAfter(projectPath(pid)).data.get('workspaceId', '') == wid
            && getAfter(projectPath(pid)).data.get('roles', {}).get(principal(), '') == 'admin');
    }

    // ---------------------------------------------------------------------
    // Company / role model (per-project company assignment)
    //
    // A project doc may carry a `companies` map { [principal]: companyId }.
    // The `company_lead` role lets a member edit content authored by other
    // members of the SAME company on that project (in addition to their own).
    // ---------------------------------------------------------------------

    // The company a given member is assigned to on a project (or '' if none).
    function memberCompany(pid, who) {
      return projectData(pid).get('companies', {}).get(who, '');
    }

    function isSameProjectCompany(wid, pid, companyId) {
      return companyId != ''
        && isProjectMember(wid, pid)
        && memberCompany(pid, principal()) == companyId;
    }

    // Vedoucí firemního prostoru = člen TÉŽE Company, který smí měnit cizí obsah.
    // Dřív to byl výčet rolí ['company_lead','editor','admin']; po zrušení
    // `company_lead` (#506) je to prostě oprávnění `edit` — legacy nositelé role
    // ho podle migrační tabulky mají dál, takže se nikomu nic nemění.
    function isCompanySpaceLead(wid, pid, companyId) {
      return isSameProjectCompany(wid, pid, companyId)
        && canEdit(wid, pid);
    }

    function hasCompanyResourceAccess(wid, pid, companyId, data) {
      return isSameProjectCompany(wid, pid, companyId)
        && (
          isCompanySpaceLead(wid, pid, companyId)
          || data.get('accessMode', '') == 'company_all'
          || (data.get('accessMode', '') == 'restricted'
              && principal() in data.get('allowedPrincipalIds', []))
        );
    }

    function validCompanyResourceIdentity(companyId, data) {
      return data.get('scope', '') == 'company_internal'
        && data.get('ownerCompanyId', '') == companyId
        && data.get('createdBy', '') == principal()
        && data.get('accessMode', '') in ['company_all', 'restricted']
        && data.get('allowedPrincipalIds', []) is list;
    }

    function companyFolderPath(wid, pid, companyId, folderId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/companySpaces/$(companyId)/folders/$(folderId);
    }

    function companyPlanPath(wid, pid, companyId, planId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/companySpaces/$(companyId)/plans/$(planId);
    }

    function canUseCompanyPlan(wid, pid, companyId, planId, data) {
      return planId != ''
        && exists(companyPlanPath(wid, pid, companyId, planId))
        && hasCompanyResourceAccess(wid, pid, companyId, get(companyPlanPath(wid, pid, companyId, planId)).data)
        && data.get('folderId', '') == get(companyPlanPath(wid, pid, companyId, planId)).data.get('folderId', '')
        && data.get('accessMode', '') == get(companyPlanPath(wid, pid, companyId, planId)).data.get('accessMode', '')
        && data.get('allowedPrincipalIds', []) == get(companyPlanPath(wid, pid, companyId, planId)).data.get('allowedPrincipalIds', []);
    }

    function canUseCompanyFolder(wid, pid, companyId, folderId, data) {
      return (
          folderId == ''
          && data.get('accessMode', '') == 'company_all'
          && data.get('allowedPrincipalIds', []).size() == 0
        ) || (
          folderId != ''
          && exists(companyFolderPath(wid, pid, companyId, folderId))
          && hasCompanyResourceAccess(wid, pid, companyId, get(companyFolderPath(wid, pid, companyId, folderId)).data)
          && data.get('accessMode', '') == get(companyFolderPath(wid, pid, companyId, folderId)).data.get('accessMode', '')
          && data.get('allowedPrincipalIds', []) == get(companyFolderPath(wid, pid, companyId, folderId)).data.get('allowedPrincipalIds', [])
        );
    }

    function validChildCompanyAccess(wid, pid, companyId, parentId, data) {
      return (
          parentId == ''
          && data.get('accessMode', '') in ['company_all', 'restricted']
        ) || (
          parentId != ''
          && exists(companyFolderPath(wid, pid, companyId, parentId))
          && hasCompanyResourceAccess(wid, pid, companyId, get(companyFolderPath(wid, pid, companyId, parentId)).data)
          && (
            get(companyFolderPath(wid, pid, companyId, parentId)).data.get('accessMode', '') == 'company_all'
            || (
              data.get('accessMode', '') == 'restricted'
              && get(companyFolderPath(wid, pid, companyId, parentId)).data.get('allowedPrincipalIds', []).hasAll(data.get('allowedPrincipalIds', []))
            )
          )
        );
    }

    // Content is authored by the caller (createdBy == principal).
    function authoredBySelf() {
      return resource.data.get('createdBy', '') == principal();
    }

    // Změna/smazání existujícího obsahu: cizí smí `edit`, vlastní `contribute`.
    // (Firemní větev pro `company_lead` zanikla — legacy nositelé té role mají
    // podle migrační tabulky rovnou `edit`, tedy víc, ne míň.)
    function canModifyWith(perms) {
      return perms.hasAny(['edit'])
        || (perms.hasAny(['contribute']) && authoredBySelf());
    }

    function canModifyContent(wid, pid) {
      return canModifyWith(permsOf(wid, pid));
    }

    // Založení obsahu = `contribute`. Author (createdBy) musí být buď
    // PRÁZDNÝ (obsah ještě nezadrátovaný na authorship → editovatelný jen
    // přes `edit`, bezpečné), nebo SÁM volající (principal) — nikdy NĚKDO JINÝ
    // (zákaz spoofingu autorství). Tím se žádný create nerozbije, i kdyby daná
    // kolekce createdBy nestampovala.
    function canCreateWith(perms) {
      return perms.hasAny(['contribute'])
        && (request.resource.data.get('createdBy', '') == ''
            || request.resource.data.get('createdBy', '') == principal());
    }

    function canCreateContent(wid, pid) {
      return canCreateWith(permsOf(wid, pid));
    }

    // Anti-spoof atribuce firmě u oficiálních dokumentů: `ownerCompanyId` na create
    // smí být buď prázdný (bez atribuce), VLASTNÍ firma volajícího, NEBO cokoli,
    // pokud volající smí měnit cizí obsah (`edit`) — ten je důvěryhodný správce
    // obsahu a legitimně přeřazuje/publikuje napříč firmami (např. rozdělení chybně
    // spárovaného dokumentu). Omezení „jen vlastní firma" tak reálně drží pro
    // publishera bez `edit`. Čte z `projects/{pid}.companies`.
    function validOfficialOwnerCompany(perms, pid) {
      return request.resource.data.get('ownerCompanyId', '') == ''
        || request.resource.data.get('ownerCompanyId', '') == memberCompany(pid, principal())
        || perms.hasAny(['edit']);
    }

    // Založení oficiálního dokumentu / revize: `publish` + anti-spoof firmy
    // a autorství. Jedno vyhodnocení množiny na celé pravidlo.
    function officialCreateOk(perms, pid) {
      return perms.hasAny(['publish'])
        && validOfficialOwnerCompany(perms, pid)
        && authorNotSpoofedOnCreate();
    }

    // Update dokumentu: běžná práva k obsahu, NEBO — u `certify`/`publish` bez
    // `edit` — jen přepnutí platné revize jako vedlejší efekt schválení/uploadu.
    function documentUpdateOk(perms) {
      return canModifyWith(perms)
        || (perms.hasAny(['certify', 'publish'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['currentVersionId', 'updatedAt']));
    }

    // Update revize dokumentu.
    //
    // `certify` zapisuje SVÉ ROZHODNUTÍ: `approvals` mapu, odvozený status
    // (i supersede předchozí verze) a razítko recenzenta.
    //
    // 🔴 Nález R5 (#506): tahle větev dřív NEMĚLA žádné omezení polí, takže
    // schvalovatel — třeba člen jinak bez práva na cizí obsah — směl u
    // libovolné verze přepsat `filePath`, `versionLabel` i `documentId`.
    // Schvalovací právo tak bylo MOCNĚJŠÍ než editorské, přestože ho smí
    // rozdat i projektový admin, který role měnit nesmí. Teď je uzavřené
    // `hasOnly` na pole rozhodnutí — přesně to, co zapisuje `documentService.ts`
    // (`updateVersionStatus` / `recordApprovalDecision`).
    //
    // Ostatní (uploader/editor/autor) smí běžné editace, ale NE přechod do
    // rozhodnutí (zákaz self-approve). Audit se v rules nevynucuje.
    function versionUpdateOk(perms) {
      return (perms.hasAny(['certify'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'approvals', 'reviewedBy', 'reviewedByName',
               'reviewedAt', 'reviewerComment', 'updatedAt'
             ]))
        || (canModifyWith(perms)
            && !(request.resource.data.status != resource.data.status
                 && request.resource.data.status in ['approved', 'approved_with_comments', 'rejected', 'superseded', 'for_construction']));
    }

    // Autor obsahu na create nesmí být podvržený: `createdBy` je prázdný nebo přímo
    // volající (principal), nikdy někdo jiný. Zrcadlí invariant `canCreateContent`,
    // který jsme u oficiálních dokumentů/verzí nahradili gate `canPublishOfficial`
    // — bez tohohle by publisher mohl podvrhnout autorství (a získat edit-own).
    function authorNotSpoofedOnCreate() {
      return request.resource.data.get('createdBy', '') == ''
        || request.resource.data.get('createdBy', '') == principal();
    }

    // ---------------------------------------------------------------------
    // Workspaces
    // ---------------------------------------------------------------------

    match /workspaces/{wid} {
      // The id is not secret; the doc only carries owner/admin metadata.
      allow get: if isRealUser();
      allow list: if false;
      // Bootstrap claim: first creator becomes owner (keyed by principal).
      allow create: if isRealUser()
        && request.resource.data.ownerId == principal()
        && request.resource.data.adminIds is list;
      // Owner can manage admins/name and workspace settings (modules,
      // storageBackend, ...) but never transfer/drop ownership here.
      // Workspace admins may update settings too, WITHOUT escalation:
      // ownerId and adminIds must stay unchanged (the admin list is
      // owner-only).
      allow update: if isRealUser()
        && (
          (resource.data.get('ownerId', '') == principal()
            && request.resource.data.ownerId == resource.data.ownerId)
          || (isWsAdmin(wid)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.adminIds == resource.data.adminIds)
        );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Companies (firm-level company directory)
    //
    // Any real user (firm member) may read the company list; only workspace
    // admins manage entries.
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/companies/{companyId} {
      allow read: if isRealUser();
      allow create, update, delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Firm member directory (workspace-level, keyed by principal)
    //
    // Any real user (firm member) may read the directory; workspace admins
    // manage entries, and a user may upsert ONLY their own entry (e.g. on
    // invite redeem to record their displayName/companyId).
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/members/{memberPrincipal} {
      allow read: if isRealUser();
      allow create, update: if isWsAdmin(wid) || principal() == memberPrincipal;
      allow delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Signál invalidace custom claims (docs/SECURITY_CLAIMS_DESIGN.md kap. 3)
    //
    // Autorizace Storage jede přes custom claims v tokenu. Token má pevnou
    // platnost 1 h a nejde zkrátit, takže po změně členství by claims mohly být
    // až hodinu zastaralé. Tenhle dokument je SIGNÁL: klient sleduje TEN SVŮJ
    // a při každé změně `rev` si vynutí `getIdToken(true)` → nové claims má
    // během sekund. Zapisuje ho Cloud Function `syncMemberClaims`, případně
    // admin klientsky.
    //
    // Číst smí JEN dotčený principal — z cizího signálu by šlo odvodit, že
    // někdo je členem téhle firmy.
    //
    // Zapisovat smí JEN vlastník/admin firmy. Běžnou cestou ho stejně píše
    // `syncMemberClaims` přes Admin SDK (rules obchází), takže klientský zápis
    // je jen doplněk.
    //
    // ⚠️ Původní verze pouštěla i „firemního člena" přes existenci dokumentu
    // `workspaces/{wid}/members/{principal}`. Ten ale zakládá `redeemInvite`
    // KAŽDÉMU pozvanému včetně hosta z cizí firmy — takže by to nebyla brána,
    // ale otevřená vrátka: kdokoli pozvaný by mohl cizím lidem vynucovat obnovu
    // tokenu (šum + náklady na Cloud Functions).
    // ---------------------------------------------------------------------

    function validAccessSignal() {
      return request.resource.data.keys().hasOnly(['rev', 'updatedAt', 'reason'])
        && request.resource.data.rev is int
        && request.resource.data.rev >= 0;
    }

    match /workspaces/{wid}/accessSignals/{signalPrincipal} {
      allow get: if isRealUser() && principal() == signalPrincipal;
      allow list: if isWsAdmin(wid);
      allow create, update: if isWsAdmin(wid) && validAccessSignal();
      allow delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Invites (bearer token documents)
    // ---------------------------------------------------------------------

    function invitePath(wid, inviteId) {
      return /databases/$(database)/documents/workspaces/$(wid)/invites/$(inviteId);
    }

    // The members/{uid} self-join create is only valid when the same batch
    // claims the referenced invite (getAfter forces atomicity).
    function redeemOk(wid, pid, inviteId, role) {
      return get(invitePath(wid, inviteId)).data.projectId == pid
        && get(invitePath(wid, inviteId)).data.usedBy == null
        && request.time < get(invitePath(wid, inviteId)).data.expiresAt
        && role == get(invitePath(wid, inviteId)).data.role
        // Only APPROVED invites are redeemable. Missing field == approved
        // (backward compat with pre-#367 invites).
        && get(invitePath(wid, inviteId)).data.get('approvalStatus', 'approved') == 'approved'
        && getAfter(invitePath(wid, inviteId)).data.usedBy == principal();
    }

    // Kdo smí pozvánku NAVRHNOUT: člen s `edit` (typicky Koordinátor / vedoucí
    // úseku), který ale nespravuje projekt. Pozvánka zůstane `pending_approval`,
    // dokud ji neschválí správce projektu / firmy (issue #367). Správci ji
    // zakládají rovnou přes `canManage` větev, tuhle nepotřebují.
    function canProposeInvite(wid, pid) {
      return canEdit(wid, pid);
    }

    match /workspaces/{wid}/invites/{inviteId} {
      // The invite id itself is the secret; any real user holding it may read.
      allow get: if isRealUser();
      allow list: if isWsAdmin(wid);
      allow create: if isRealUser()
        // Pozvánkou nejde udělit `admin` (eskalace) — jen role bez `manage`.
        && request.resource.data.role in ['reader', 'viewer', 'editor']
        && request.resource.data.usedBy == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.createdBy == principal()
        && (
            // Direct: project admin / workspace admin issues a live invite.
            (canManage(wid, request.resource.data.projectId)
              && request.resource.data.get('approvalStatus', 'approved') == 'approved')
            // Manager/company lead proposes an invite needing admin approval.
            || (canProposeInvite(wid, request.resource.data.projectId)
              && request.resource.data.approvalStatus == 'pending_approval')
        );
      allow update: if (
          // Redeem: only claiming an unused, unexpired, APPROVED invite for yourself.
          isRealUser()
          && resource.data.usedBy == null
          && resource.data.get('approvalStatus', 'approved') == 'approved'
          && request.time < resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == principal()
        )
        // Approve/reject + revoke: project admin / ws admin may edit the invite
        // (this also covers flipping approvalStatus pending_approval -> approved).
        || canManage(wid, resource.data.projectId);
      allow delete: if canManage(wid, resource.data.projectId);
    }

    // ---------------------------------------------------------------------
    // Project members mirror (UI metadata; rules read /projects instead)
    //
    // 🔴 Nález R1 (#506): tenhle allowlist byl JEDINÉ místo, které minul rename
    // `company_editor → company_lead`. Pravidla pouštěla `company_editor`, který
    // v `src/` neexistoval, a odmítala `company_lead`, který existoval — takže
    // se „Vedoucí úseku" zapsal do vynuceného `projects.roles`, ale ne do
    // zrcadla, a tentýž člověk měl na dvou obrazovkách dvě různé role.
    // Fáze 2 roli ruší úplně, takže tu není ani jeden z těch mrtvých názvů.
    //
    // `roleAssignable` = role, kterou lze NOVĚ přiřadit. Legacy hodnota (dnes
    // `company_lead`) smí v dokumentu ZŮSTAT — jinak by byl takový záznam
    // zamčený navždy a nešlo by u něj nastavit ani `canApprove` (probe P4).
    // ---------------------------------------------------------------------

    function roleAssignable(role) {
      return role in ['reader', 'viewer', 'editor', 'admin'];
    }

    function roleWriteOk() {
      return roleAssignable(request.resource.data.get('role', ''))
        || request.resource.data.get('role', '') == resource.data.get('role', '');
    }

    match /workspaces/{wid}/projects/{pid}/members/{memberUid} {
      allow get, list: if isProjectMember(wid, pid);
      allow create: if (
          // Self-join via invite redeemed in the same batch.
          // members/{id} doc is keyed by principal (federated subject or uid).
          isRealUser()
          && memberUid == principal()
          && request.resource.data.keys()
              .hasOnly(['role', 'displayName', 'email', 'inviteId', 'joinedAt', 'companyId'])
          && request.resource.data.role in ['reader', 'viewer', 'editor']
          && redeemOk(wid, pid, request.resource.data.inviteId,
              request.resource.data.role)
        ) || (
          canManageAfter(wid, pid)
          && roleAssignable(request.resource.data.get('role', ''))
        );
      allow update: if canManageAfter(wid, pid) && roleWriteOk();
      allow delete: if canManage(wid, pid);
    }

    // Firemní interní pracovní prostory jsou oddělené od oficiálních kolekcí,
    // aby legacy list query nikdy nemíchaly obsah s rozdílnou viditelností.
    match /workspaces/{wid}/projects/{pid}/companySpaces/{companyId} {
      allow get: if isSameProjectCompany(wid, pid, companyId);
      allow list: if false;
      allow create: if (isSameProjectCompany(wid, pid, companyId) || canManage(wid, pid))
        && request.resource.data.get('companyId', '') == companyId
        && request.resource.data.get('projectId', '') == pid
        && request.resource.data.get('workspaceId', '') == wid
        && request.resource.data.get('scope', '') == 'company_internal'
        && request.resource.data.get('createdBy', '') == principal();
      allow update: if isCompanySpaceLead(wid, pid, companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.scope == resource.data.scope;
      allow delete: if false;

      match /folders/{folderId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if isCompanySpaceLead(wid, pid, companyId)
          && validCompanyResourceIdentity(companyId, request.resource.data)
          && request.resource.data.get('folderId', '') == folderId
          && request.resource.data.get('parentId', '') != folderId
          && validChildCompanyAccess(wid, pid, companyId, request.resource.data.get('parentId', ''), request.resource.data);
        allow update: if isCompanySpaceLead(wid, pid, companyId)
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('folderId', '') == resource.data.get('folderId', '')
          && request.resource.data.get('parentId', '') != folderId
          && validChildCompanyAccess(wid, pid, companyId, request.resource.data.get('parentId', ''), request.resource.data);
        allow delete: if isCompanySpaceLead(wid, pid, companyId);
      }

      match /documents/{documentId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('documentId', '') == documentId
          && request.resource.data.get('approvalMode', '') == 'none'
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow update: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId))
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('approvalMode', '') == 'none'
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow delete: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId));
      }

      match /documentVersions/{versionId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('versionId', '') == versionId
          && request.resource.data.get('status', '') == 'working'
          && request.resource.data.get('workflowMode', '') == 'none'
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow update: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId))
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow delete: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId));
      }

      match /plans/{planId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('planId', '') == planId
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow update: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId))
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data);
        allow delete: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && (resource.data.get('createdBy', '') == principal() || isCompanySpaceLead(wid, pid, companyId));
      }

      // Sdílené firemní markupy jednoho planVersion. Task piny sem nepatří a
      // zůstávají v betě zakázané; dokument obsahuje pouze geometrické anotace.
      // Pozn.: rules neumí iterovat prvky listu, takže per-item typ nevaliduje —
      // task piny jsou v appce samostatné Tasky (ne anotace), FE je do `items`
      // nikdy nezapisuje a nad firemním plánem je i vytvoření pinu vypnuté.
      // Zde vynucujeme aspoň strop velikosti pole proti zneužití zápisem.
      match /planAnnotationSets/{versionId} {
        allow get: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow list: if isCompanySpaceLead(wid, pid, companyId);
        allow create: if isSameProjectCompany(wid, pid, companyId)
          && validCompanyResourceIdentity(companyId, request.resource.data)
          && request.resource.data.get('planVersionId', '') == versionId
          && request.resource.data.get('items', []) is list
          && request.resource.data.get('items', []).size() <= 2000
          && canUseCompanyPlan(wid, pid, companyId, request.resource.data.get('planId', ''), request.resource.data);
        allow update: if hasCompanyResourceAccess(wid, pid, companyId, resource.data)
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('planId', '') == resource.data.get('planId', '')
          && request.resource.data.get('planVersionId', '') == resource.data.get('planVersionId', '')
          && request.resource.data.get('items', []) is list
          && request.resource.data.get('items', []).size() <= 2000
          && canUseCompanyPlan(wid, pid, companyId, request.resource.data.get('planId', ''), request.resource.data);
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Notification queue (recipient-scoped reads)
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/projects/{pid}/notificationQueue/{notificationId} {
      allow create: if isProjectMember(wid, pid)
        && request.resource.data.workspaceId == wid
        && request.resource.data.projectId == pid
        && request.resource.data.recipientIds is list;
      // Provable for queries shaped
      // where('recipientIds', 'array-contains', currentPrincipal).
      allow get, list: if isRealUser()
        && principal() in resource.data.recipientIds;
      // Recipients may only append themselves to readBy.
      allow update: if isRealUser()
        && principal() in resource.data.recipientIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy'])
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && principal() in request.resource.data.readBy;
      allow delete: if canManage(wid, pid);
    }

    // ---------------------------------------------------------------------
    // Project content collections (explicit enumeration -- no catch-all so
    // members/notificationQueue/invites can never be reached through these).
    // ---------------------------------------------------------------------

    // Task status-transition guard (issue #367, docs/TASK_WORKFLOW_USER_STORIES).
    // 'completed' = `edit` nebo autor (OQ-4); 'verified' = `certify` (OQ-5);
    // vrátit verified = `edit` (OQ-6a). Enforcuje se JEN na změně statusu;
    // nezměněný status projde komukoli, kdo smí obsah upravit (editace jiných
    // polí u hotového úkolu se nerozbije).
    function canCompleteTask(perms) {
      return perms.hasAny(['edit']);
    }
    // Autor úkolu (createdBy == principal). Funguje pro create i update — createdBy
    // je u update immutable, takže request.resource nese autora v obou případech.
    function taskAuthoredBySelf() {
      return request.resource.data.get('createdBy', '') == principal();
    }
    // Kdo smí dostat úkol DO „hotovo" stavu (issue #367, viz TASK_WORKFLOW_USER_STORIES):
    //  - 'verified'  = `certify` — OQ-5
    //  - 'completed' = `edit` NEBO autor vlastního úkolu — OQ-4
    function canReachDoneStatus(perms, status) {
      return status == 'verified' ? perms.hasAny(['certify'])
        : status == 'completed' ? (canCompleteTask(perms) || taskAuthoredBySelf())
        : true;
    }
    // Návrat ZPĚT z „hotovo" stavu (reopen). Dopředný postup completed→verified NENÍ
    // reopen (řeší ho jen canReachDoneStatus = `certify`), proto se sem nepočítá.
    //  - z 'verified'  = Koordinátor+ (vrací nalezenou vadu; nemusí být admin) — OQ-6a
    //  - z 'completed' do práce = Koordinátor+ NEBO autor — OQ-6c
    function reopenOk(perms, oldStatus, newStatus) {
      return oldStatus == 'verified' ? canCompleteTask(perms)
        : (oldStatus == 'completed' && newStatus != 'verified')
            ? (canCompleteTask(perms) || taskAuthoredBySelf())
        : true;
    }
    // Přechod je OK, když se status NEMĚNÍ, nebo když volající smí CÍLOVÝ dosáhnout
    // A (jde-li o návrat z hotovo) smí i reopen. verified nastaví Schvalovatel,
    // vrací Koordinátor+.
    function taskStatusTransitionOk(perms) {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
        || (canReachDoneStatus(perms, request.resource.data.get('status', ''))
            && reopenOk(perms, resource.data.get('status', ''), request.resource.data.get('status', '')));
    }

    // ── #358 Interní úkoly firmy (scope = company_internal) ──────────────────
    // Interní úkol vidí a řídí JEN členové vlastnící firmy (memberCompany ==
    // ownerCompanyId), napříč celým projektem — i mimo firmu (projektový admin,
    // wsAdmin) ho nevidí. Kdokoli z firmy smí na 'completed'; na 'verified' jen
    // vedoucí firmy. scope i ownerCompanyId jsou po vzniku neměnné.
    function taskIsInternal(data) {
      return data.get('scope', 'project_official') == 'company_internal';
    }
    // Volající je členem firmy vlastnící daný interní úkol (dle ownerCompanyId).
    function taskCompanyMember(pid, data) {
      return data.get('ownerCompanyId', '') != ''
        && memberCompany(pid, principal()) == data.get('ownerCompanyId', '');
    }
    // Identita interního úkolu při vzniku: vlastní firma, bez spoofingu.
    function validInternalTaskCreate(pid) {
      return request.resource.data.get('ownerCompanyId', '') != ''
        && request.resource.data.get('ownerCompanyId', '') == memberCompany(pid, principal());
    }
    // scope i ownerCompanyId jsou po vzniku neměnné — rozsah nelze „přepnout".
    function taskScopeImmutable() {
      return request.resource.data.get('scope', 'project_official')
               == resource.data.get('scope', 'project_official')
        && request.resource.data.get('ownerCompanyId', '')
               == resource.data.get('ownerCompanyId', '');
    }
    // Interní úkol: na 'verified' jen vedoucí firmy; ostatní stavy kdokoli z firmy.
    function internalTaskStatusOk(wid, pid) {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
        || (request.resource.data.get('status', '') == 'verified'
            ? isCompanySpaceLead(wid, pid, resource.data.get('ownerCompanyId', ''))
            : true);
    }

    // 🔑 JÁDRO #506: ověření úkolu je VLASTNÍ PŘECHOD, ne update cizího obsahu.
    //
    // Dosud update úkolu vyžadoval `canModifyContent`, takže schvalovatel bez
    // editačních práv (TDI, projektant) nemohl posunout do `verified` NIC, co
    // sám nenapsal — přestože `canReachDoneStatus` mu to výslovně dovolovalo.
    // Kontrolní role tedy nemohla provést kontrolní úkon.
    //
    // Tahle větev je úzká schválně: JEN přechod do `verified` a JEN pole, která
    // u toho zapisuje klient (`serializeTask` → status + razítko). Obsah úkolu
    // (název, popis, řešitel, přílohy) zůstává schvalovateli zapovězený —
    // `certify` je právo stvrdit, ne právo přepsat.
    function certifyTaskVerification(perms) {
      return perms.hasAny(['certify'])
        && request.resource.data.get('status', '') == 'verified'
        && resource.data.get('status', '') != 'verified'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedByUserId', 'activityLog']);
    }

    // Nový úkol nesmí rovnou vzniknout jako completed/verified bez příslušného
    // oprávnění (jinak by šel guard na update obejít vytvořením už-hotového
    // úkolu). Interní úkol: člen zakládá do své firmy a nesmí vzniknout rovnou
    // jako 'verified'.
    function taskCreateOk(perms, pid) {
      return canCreateWith(perms) && (
        taskIsInternal(request.resource.data)
          ? (validInternalTaskCreate(pid)
             && request.resource.data.get('status', '') != 'verified')
          : canReachDoneStatus(perms, request.resource.data.get('status', ''))
      );
    }

    // Update PROJEKTOVÉHO úkolu: buď běžná práva k obsahu se stavovým guardem,
    // nebo úzká větev pro schvalovatele bez `edit` (ověření cizího úkolu).
    function taskProjectUpdateOk(perms) {
      return (canModifyWith(perms) && taskStatusTransitionOk(perms))
        || certifyTaskVerification(perms);
    }

    function taskPath(wid, pid, taskId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/tasks/$(taskId);
    }

    // Fotky/piny mohou referencovat úkol (taskId / context.taskId). Pokud ten
    // úkol je interní (scope=company_internal), nesmí referenci prozradit
    // (existenci + evidence photo URL) nikomu mimo vlastnící firmu — jinak by
    // photos/photoPins gate obcházel tasks gate výše. Bez taskId, s taskId na
    // neexistující/smazaný dokument, nebo na projektový (ne-interní) úkol se
    // chování nemění (čte kterýkoli člen projektu). exists()/get() na stejnou
    // cestu se v rámci jednoho requestu cachují (max +1 čtení navíc).
    function taskLinkReadOk(wid, pid, taskId) {
      return taskId == ''
        || !exists(taskPath(wid, pid, taskId))
        || !taskIsInternal(get(taskPath(wid, pid, taskId)).data)
        || taskCompanyMember(pid, get(taskPath(wid, pid, taskId)).data);
    }

    match /workspaces/{wid}/projects/{pid}/tasks/{docId} {
      // Interní úkol (scope=company_internal) čte jen člen vlastnící firmy;
      // projektový úkol kterýkoli člen projektu.
      allow read: if isProjectMember(wid, pid)
        && (!taskIsInternal(resource.data) || taskCompanyMember(pid, resource.data));
      // Nový úkol nesmí rovnou vzniknout jako completed/verified bez příslušné role
      // (jinak by šel guard na update obejít vytvořením už-hotového úkolu).
      // Interní úkol: člen zakládá do své firmy a nesmí vzniknout rovnou jako 'verified'.
      allow create: if taskCreateOk(permsOf(wid, pid), pid);
      // createdBy, scope i ownerCompanyId immutable. Interní úkol upraví člen
      // vlastnící firmy (na 'verified' jen vedoucí); projektový dle stávajících pravidel.
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && taskScopeImmutable()
        && (
          taskIsInternal(resource.data)
            ? (taskCompanyMember(pid, resource.data) && internalTaskStatusOk(wid, pid))
            : taskProjectUpdateOk(permsOf(wid, pid))
        );
      // Interní úkol smaže vedoucí firmy nebo autor (z vlastní firmy); projektový dle stávajících.
      allow delete: if taskIsInternal(resource.data)
        ? (taskCompanyMember(pid, resource.data)
           && (isCompanySpaceLead(wid, pid, resource.data.get('ownerCompanyId', '')) || authoredBySelf()))
        : canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/files/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/photos/{docId} {
      // #358 leak fix: fotka navázaná na interní úkol (Photo.taskId) je čitelná
      // jen členům firmy vlastnící ten úkol — jinak by prozradila jeho existenci
      // a evidence URL mimo tasks gate výše.
      allow read: if isProjectMember(wid, pid)
        && taskLinkReadOk(wid, pid, resource.data.get('taskId', ''));
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // Připnutí fotky do kontextu (task/plán) + anotace té varianty. Fotka samotná
    // zůstává jeden záznam v /photos; pin ji jen referencuje (photoId).
    match /workspaces/{wid}/projects/{pid}/photoPins/{docId} {
      // #358 leak fix: stejná gate jako u /photos, jen taskId čteme z
      // PhotoPin.context.taskId (vnořené pole).
      allow read: if isProjectMember(wid, pid)
        && taskLinkReadOk(wid, pid, resource.data.get('context', {}).get('taskId', ''));
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/diaryEntries/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // Plány: číst smí každý člen (`read`), měnit jen `edit`. Do #506 fáze 2
    // NEMĚL modul Plány na klientu ŽÁDNOU bránu — čtenář dostal celý toolbar
    // včetně markupu a kalibrace měřítka, zápis mu pravidla odmítla a appka ho
    // schovala do localStorage (nálezy U1–U3, F4). Klientská brána je teď
    // v `PlansPage`/`PlanViewer` a zrcadlí přesně tahle dvě práva.
    match /workspaces/{wid}/projects/{pid}/plans/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if canEdit(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/planAnnotations/{docId} {
      // Soukromý markup (isPrivate) vidí JEN jeho autor (ownerPrincipal == principal);
      // veřejné vidí každý člen. Klient čte dvěma dotazy (veřejné + vlastní soukromé).
      allow read: if isProjectMember(wid, pid)
        && (resource.data.get('isPrivate', false) == false
            || resource.data.get('ownerPrincipal', '') == principal());
      allow create, update, delete: if canEdit(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documents/{docId} {
      allow read: if isProjectMember(wid, pid);
      // Do OFICIÁLNÍ dokumentace smí zakládat jen `publish`, ne každý člen.
      // Atribuce firmě jen na vlastní firmu (anti-spoof) a autor nesmí být podvržený.
      allow create: if officialCreateOk(permsOf(wid, pid), pid);
      // Author immutable. Editovat smí běžná práva k obsahu; `certify` nebo
      // `publish` navíc smí jako vedlejší efekt upload/approve transakce
      // přepnout jen platnou revizi (currentVersionId/updatedAt) — i když nemá
      // `edit` ani autorství (schválení revize / nová revize od publikujícího).
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && documentUpdateOk(permsOf(wid, pid));
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentVersions/{docId} {
      allow read: if isProjectMember(wid, pid);
      // Nahrát verzi do oficiální dokumentace smí jen `publish` (viz documents).
      allow create: if officialCreateOk(permsOf(wid, pid), pid);
      // `certify` (schvalovatel) smí zapsat SVÉ ROZHODNUTÍ: `approvals` mapu,
      // odvozený status (i supersede předchozí verze) a razítko recenzenta.
      //
      // 🔴 Nález R5 (#506): dřív tahle větev NEMĚLA žádné omezení polí, takže
      // schvalovatel — třeba člen jinak bez práva na cizí obsah — směl u
      // libovolné verze přepsat `filePath`, `versionLabel` i `documentId`.
      // Schvalovací právo tak bylo MOCNĚJŠÍ než editorské, přestože ho smí
      // rozdat i projektový admin, který role měnit nesmí. Teď je uzavřené
      // `hasOnly` na pole rozhodnutí — přesně to, co zapisuje
      // `documentService.ts` (`updateVersionStatus` / `recordApprovalDecision`).
      //
      // Ostatní (uploader/editor/autor) smí běžné editace, ale NE přechod do
      // rozhodnutí (zákaz self-approve). Audit se v rules nevynucuje.
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')  // author immutable
        && versionUpdateOk(permsOf(wid, pid));
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentComments/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // Registr složek projektu (Fáze 1, bez per-složkových práv). Člen smí číst
    // a zakládat složky; mazat/měnit editor/admin/autor (canModifyContent).
    match /workspaces/{wid}/projects/{pid}/folders/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update, delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/transmittals/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if canEdit(wid, pid);
    }

    // Zapečený stav dokumentace na hranici fáze — immutable otisk sady verzí.
    // Číst smí člen; zakládat/mazat editor; UPDATE ZAKÁZÁN (obsah je neměnný).
    // Bez `allow update` → updaty spadají do default-deny = immutabilita
    // vynucená rules (stejný vzor jako share pointer, jen tady i list pro člena).
    match /workspaces/{wid}/projects/{pid}/documentBaselines/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, delete: if canEdit(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentEvents/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if canEdit(wid, pid);
    }

    // ---------------------------------------------------------------------
    // Share links (bearer token documents -- public read-out of a single item)
    //
    // The token (doc id) is the secret, so `get` is public: an unauthenticated
    // recipient holding the link reads exactly that one record (title + a
    // already-public file URL -- never sensitive metadata). Listing requires
    // membership (managing share links), and only editors+ may create/revoke.
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/projects/{pid}/shareLinks/{token} {
      allow get: if true;
      allow list: if isProjectMember(wid, pid);
      allow create, update, delete: if canEdit(wid, pid);
    }

    // ---------------------------------------------------------------------
    // Document status pointer (#371 — verifikace revize přes QR)
    //
    // Public pointer to a document's CURRENT version so the anonymous
    // verification page (/share/:wid/:token) can tell whether the scanned
    // revision is current or superseded. Carries ONLY harmless data
    // (currentVersionId + label) -- never titles, URLs or member info.
    // Zapisuje se best-effort při uploadu (`edit`/`publish`) i při schválení
    // (`certify`) — schvalovatel ani publisher nemusí mít `edit`, proto tu jsou
    // všechny tři větve. Bez `publish` končila QR verifikace čerstvě nahrané
    // revize „neutrálním stavem" (nález F2).
    // ---------------------------------------------------------------------

    function validDocumentStatus(data) {
      // Veřejně čitelný doc — schema guard: JEN neškodná pole, žádné volné klíče.
      return data.keys().hasOnly(['currentVersionId', 'currentVersionLabel', 'updatedAt'])
        && data.currentVersionId is string && data.currentVersionId.size() > 0
        && data.currentVersionLabel is string;
    }

    match /workspaces/{wid}/projects/{pid}/documentStatus/{documentId} {
      allow get: if true;
      allow list: if isProjectMember(wid, pid);
      allow create, update: if permsOf(wid, pid).hasAny(['edit', 'certify', 'publish'])
        && validDocumentStatus(request.resource.data);
      allow delete: if canEdit(wid, pid);
    }

    // ---------------------------------------------------------------------
    // Top-level projects (source of truth for membership)
    // ---------------------------------------------------------------------

    // Invite self-join on the project doc: only adds the caller to
    // memberIds/roles, with the role copied from the members doc created in
    // the same batch (which itself requires a valid invite claim).
    function inviteSelfJoin(pid) {
      return isRealUser()
        && !(principal() in resource.data.get('memberIds', []))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'roles', 'updatedAt', 'companies'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAll(resource.data.get('memberIds', []))
        && request.resource.data.memberIds.size()
            == resource.data.get('memberIds', []).size() + 1
        && principal() in request.resource.data.memberIds
        && request.resource.data.roles.diff(resource.data.get('roles', {}))
            .affectedKeys().hasOnly([principal()])
        && request.resource.data.roles[principal()]
            == getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/projects/$(pid)/members/$(principal())).data.role;
    }

    match /projects/{pid} {
      // Direct field access keeps the rule provable for both query shapes:
      // where('memberIds','array-contains', principal) and
      // where('workspaceId','==', wid) issued by workspace admins.
      allow get, list: if isRealUser()
        && (principal() in resource.data.memberIds
            || isWsAdmin(resource.data.workspaceId));
      allow create: if isRealUser()
        && isWsAdmin(request.resource.data.workspaceId)
        && principal() in request.resource.data.memberIds
        && request.resource.data.roles.get(principal(), '') == 'admin';
      // Workspace owner/admin: full project doc control incl. membership.
      // Project admin: may edit project content but MUST NOT touch
      // memberIds/roles (membership changes only via wsAdmin or invite flow),
      // preventing one admin from demoting/removing other admins or the owner.
      allow update: if (
          isRealUser()
          && isWsAdmin(resource.data.get('workspaceId', ''))
          && request.resource.data.workspaceId == resource.data.workspaceId
        ) || (
          isRealUser()
          && resource.data.get('roles', {}).get(principal(), '') == 'admin'
          && request.resource.data.workspaceId == resource.data.workspaceId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['memberIds', 'roles'])
        ) || (
          // Značka „stavba žije" — `lastActivityAt`
          // (docs/BILLING_IMPLEMENTATION.md kap. 2.2, návrh
          // docs/ai/blok-a-rules-navrh.md). Píše ji `src/services/projectActivity.ts`
          // po jakékoli práci na stavbě, takže ji musí umět zapsat i běžný
          // přispěvatel, který do project docu jinak psát nesmí. Bez téhle
          // větve se značka zapisuje jen tehdy, když je zrovna online správce —
          // tedy prakticky nikdy, a měření je k ničemu.
          //
          // Uzavřené `hasOnly` (ne `!hasAny([...])`): propustí PRÁVĚ jeden klíč,
          // takže se přes tuhle větev nedá sáhnout na memberIds/roles/
          // workspaceId/archived/modules — ani na pole, která na project docu
          // teprve přibudou. Allowlist přes `!hasAny` by naopak s každým novým
          // polem tiše otevíral díru.
          //
          // Nejhorší možné zneužití: člen zapíše nepravdivý čas poslední
          // aktivity na stavbě, kde stejně je členem.
          isRealUser()
          && principal() in resource.data.get('memberIds', [])
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActivityAt'])
          // ISO řetězec, shodně s createdAt/updatedAt v src/services/projects.ts.
          && request.resource.data.lastActivityAt is string
        ) || inviteSelfJoin(pid);
      allow delete: if isRealUser()
        && (resource.data.get('roles', {}).get(principal(), '') == 'admin'
            || isWsAdmin(resource.data.get('workspaceId', '')));
    }

    // ---------------------------------------------------------------------
    // Počítadlo spotřeby stavby — `projects/{pid}/usage/{docId}`
    // (docs/BILLING_IMPLEMENTATION.md kap. 2.3, návrh docs/ai/blok-a-rules-navrh.md).
    //
    // Mění se VÝHRADNĚ přírůstkem (`FieldValue.increment`) při uploadu nebo
    // trvalém smazání — `src/services/projectUsage.ts`. Že jde opravdu
    // o increment, rules ověřit nedokážou; vynutitelné maximum je uzavřený
    // seznam klíčů (`hasOnly`), aby se do dokumentu nedaly propašovat cizí pole
    // (`plan`, `amount`, …), ze kterých by někdo mohl začít odvozovat cenu.
    //
    // 🔴 Zápis je klientský, tedy FALŠOVATELNÝ. Vědomě přijaté: tenhle blok
    // MĚŘÍ, nefakturuje. Až se z čísla bude počítat částka, musí se přepnout na
    // `allow write: if false` a psát ho Cloud Function — stejně jako
    // `workspaces/{wid}/billing/current`. Do té doby se z `usage` nesmí
    // odvozovat žádná částka.
    //
    // Proč je bránou zápisu ČLENSTVÍ, a ne oprávnění `edit`: novou fotku smí
    // založit každý člen projektu VČETNĚ viewera — `photos` gatuje
    // `canCreateContent` a `storage.rules` výslovně pouští založení nového
    // objektu „každému členu projektu včetně viewera". S užší bránou by
    // viewerův upload počítadlo nezvedl a spotřeba by se tiše PODhodnotila —
    // přesně ta třída chyby, kvůli které tahle pravidla vznikla. Nikomu to
    // nedává nic navíc: kdo smí nahrávat obsah, ten číslem stejně hýbe.
    match /projects/{pid}/usage/{docId} {
      allow read: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      // POZOR: `create, update` — NIKDY `write`. `allow write` pokrývá i delete
      // a s `allow delete: if false` níž by se OR-oval (souběžné allow větve se
      // skládají SJEDNOCENÍM, ne průnikem), takže by zákaz mazání byl pouhá
      // dekorace a počítadlo by šlo vynulovat smazáním dokumentu. Ověřeno
      // v emulátoru: `allow write` + `allow delete: if false` mazání PUSTÍ.
      // (Že to dnes při doslovném `hasOnly` nespadne, je jen náhoda —
      // `request.resource` je u delete null, takže výraz skončí chybou. Na
      // takové náhodě se bezpečnost stavět nesmí.)
      allow create, update: if isProjectMember(projectData(pid).get('workspaceId', ''), pid)
        && request.resource.data.keys()
             .hasOnly(['storageBytes', 'photoCount', 'docCount', 'updatedAt'])
        && request.resource.data.get('storageBytes', 0) is number
        && request.resource.data.get('photoCount', 0) is number
        && request.resource.data.get('docCount', 0) is number;
      // Počítadlo se snižuje ZÁPORNÝM přírůstkem, ne mazáním dokumentu.
      allow delete: if false;
    }

    // Neměnná auditní stopa projektu.
    //
    // 🟠 Nález F3 (#506): create dřív vyžadoval `canEditContent`, jenže úkol smí
    // legitimně posunout i přispěvatel (svůj vlastní) a nově SCHVALOVATEL
    // (`certify` → `verified` na cizím úkolu). Právě u nich audit dává největší
    // smysl, a právě jim zápis pravidla odmítla — takže „schvalovatel ověřil
    // úkol" se do stopy nikdy nezapsalo. Zápis je proto na úrovni ČLENSTVÍ:
    // záznam je stejně append-only (update i delete zůstávají zakázané), takže
    // širší brána nedovolí historii přepsat, jen doplnit.
    match /projects/{pid}/task_audit/{entryId} {
      allow read: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      allow create: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      allow update, delete: if false;
    }

    // Legacy annotation blobs -- superseded by
    // workspaces/{wid}/projects/{pid}/planAnnotations.
    match /plan_annotations/{docId} {
      allow read, write: if false;
    }

    // User registry (workspace connections) — used when this project also
    // serves as the central/login project (single-project deployment).
    // Owner-only: each user reads/writes only their own registry doc.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // Pending invites registry (CENTRÁLNÍ projekt openbuildos)
    //
    // Mirror firemní pozvánky, aby ji pozvaný NAŠEL po přihlášení i bez linku
    // (firemní invite žije jen ve workspaces/{wid}/invites/{token}, kam nemá
    // přístup). Doc id = token = bearer tajemství (náhodný UUID).
    //
    // Čte JEN adresát (match jeho ověřeného e-mailu), publikuje libovolný reálný
    // uživatel (zvoucí admin firmy), status flipne JEN adresát. Pole nesou
    // veřejné klientské identifikátory firmy (apiKey ap.) pro sestavení
    // WorkspaceConnection při přijetí — nic tajného.
    // Query příjemce: where('inviteeEmail','==', mojeEmail) & where('status','==','pending').
    // ---------------------------------------------------------------------
    match /pendingInvites/{token} {
      // Adresát čte svoje pozvánky (i výpisem). Zvoucí smí přečíst JEN konkrétní
      // pozvánku, kterou sám založil (`get`, ne `list`) — potřebuje to relay
      // zvacích e-mailů, který dokument čte JMÉNEM přihlášeného uživatele, takže
      // oprávnění vynutí tahle rule. Rozšířit i `list` by dovolilo enumeraci
      // cizích pozvánek, proto výpis zůstává jen adresátovi.
      allow get: if isRealUser()
        && (resource.data.get('inviteeEmail', '') == request.auth.token.get('email', '')
            || (resource.data.get('inviterEmail', '') != ''
                && resource.data.get('inviterEmail', '') == request.auth.token.get('email', '')));
      allow list: if isRealUser()
        && resource.data.get('inviteeEmail', '') == request.auth.token.get('email', '');
      // POZOR (bezpečnost): tento create dovoluje LIBOVOLNÉMU reálnému uživateli
      // vytvořit pozvánku s libovolným authExchangeUrl/apiKey mířícím na cizí
      // backend. hasOnly níže zamezuje injektáži cizích polí a inviterEmail se
      // váže na skutečného odesílatele (nelze se vydávat za kolegu podle e-mailu),
      // ale JÁDRO rizika (klient si sám píše authExchangeUrl) tím vyřešené NENÍ —
      // ten musí ošetřit konzument tokenu na FE (re-derivace z config/public +
      // potvrzení cíle uživatelem), případně přesun zápisu do Cloud Function.
      allow create: if isRealUser()
        // POZOR: 'token' tu MUSÍ být. Klient ho zapisuje i do dat (nejen jako
        // doc id) — bez něj hasOnly zápis odmítne a pozvánka se do centrálního
        // registru vůbec nedostane. Přesně to se stalo po #396: publikace tiše
        // padala na permission-denied, takže adresát pozvánku nikdy neuviděl
        // v Hubu a nešlo ji ani odeslat e-mailem.
        && request.resource.data.diff({}).affectedKeys().hasOnly([
             'token', 'workspaceId', 'workspaceName', 'apiKey', 'authExchangeUrl',
             'projectId', 'projectName', 'role', 'inviteeEmail',
             'inviterName', 'inviterEmail', 'status', 'createdAt', 'expiresAt'
           ])
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('inviteeEmail', '') is string
        && request.resource.data.get('inviteeEmail', '') != ''
        // inviterEmail smí být buď prázdný/null (admin bez e-mailu), nebo se MUSÍ
        // shodovat s e-mailem odesílatele — nelze se vydávat za konkrétního kolegu.
        && (request.resource.data.get('inviterEmail', null) == null
            || request.resource.data.get('inviterEmail', '') == request.auth.token.get('email', ''))
        && request.resource.data.get('role', '') in ['reader', 'viewer', 'editor'];
      // Adresát smí jen překlopit status (přijmout/odmítnout), nic jiného.
      allow update: if isRealUser()
        && resource.data.get('inviteeEmail', '') == request.auth.token.get('email', '')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Veřejná konfigurace firmy (federační URL pro auto-discovery)
    //
    // `config/public` = { authExchangeUrl }. Zapisuje setup CLI (admin SDK /
    // REST s tokenem vlastníka, mimo rules). Čte se VEŘEJNĚ (i bez přihlášení),
    // aby si appka při připojení firmy doplnila URL token-exchange funkce sama —
    // bez ručního opisování z výstupu CLI. URL endpointu NENÍ tajná (autorizaci
    // dělá samotná funkce ověřením centrálního ID tokenu).
    // ---------------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // No catch-all: everything else is denied by default.
  }
}
