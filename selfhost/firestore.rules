rules_version = '2';

// OpenBuildOS workspace-project security rules.
//
// MODEL OPRÁVNĚNÍ (#506, fáze 2): role není stupeň na škále, ale POJMENOVANÁ
// KOMBINACE nezávislých oprávnění `read` · `contribute` · `edit` · `certify` ·
// `publish` · `manage`. Vstupní bod je helper `hasPerm()` níž; nic jiného už
// nesmí rozhodovat podle názvu role. Klientské zrcadlo modelu žije v
// `src/lib/permissions/projectPermissions.ts`.
//
// ---------------------------------------------------------------------------
// 🔴 PRINCIP „PRŮKAZNÉHO VÝPISU" (nález A1, #535) — ČTI, NEŽ PŘIDÁŠ ČTECÍ BRÁNU
//
// `get` a `list` jsou DVĚ RŮZNÉ OTÁZKY. `get` se ptá skutečného dokumentu;
// `list` se vyhodnocuje SYMBOLICKY proti omezením dotazu — pole, na které se
// dotaz neptá, je pro pravidla neznámé. A tady je ta past:
//
//   · `resource.data.pole`           … neznámé pole = CHYBA výrazu  → deny  ✅
//   · `resource.data.get('pole', d)` … neznámé pole = VÝCHOZÍ `d`   → allow ❌
//
// Zápis s výchozí hodnotou tedy ve výpisu selhává OTEVŘENĚ. Dokud tohle platilo,
// šla KAŽDÁ čtecí brána postavená na `.get()` obejít tím, že si útočník místo
// dokumentu vyžádal výpis kolekce: interní úkoly firmy (#358), fotky a piny na
// ně navázané, soukromý markup v Plánech i celý registr `pendingInvites`.
//
// PRAVIDLA, KTERÁ Z TOHO PLYNOU (platí i pro pole, která teprve přibudou):
//
//   1. Kde viditelnost závisí na OBSAHU dokumentu, se `allow read` NEPOUŽÍVÁ.
//      Rozděl na `allow get` (plná brána, klidně přes `.get()` i cizí dokumenty)
//      a `allow list` (vlastní, průkazná brána).
//   2. Ve `list` větvi se pole čtou VÝHRADNĚ PŘÍMÝM PŘÍSTUPEM (`resource.data.x`).
//      `resource.data.get(x, default)` je tam ZAKÁZANÝ. Důsledek: dotaz, který
//      to pole nezúží, se odmítne — a klient musí posílat tvar, který brána umí
//      dokázat. (Na `request.resource.data` je `.get()` dál v pořádku: u zápisu
//      je celý dokument známý.)
//   3. Když brána potřebuje CIZÍ dokument (`get()` jinam), z dotazu se dokázat
//      NEDÁ. Pak rozhodující údaj musí být DENORMALIZOVANÝ na dokumentu samotném
//      a ověřený při zápisu — jinak citlivá data do listovatelné kolekce nepatří.
//
// Nositelem bodu 3 je pole `visibility` (viz helper `visibleInList` níž):
// `''` = vidí celá stavba, `<companyId>` = vidí jen ta firma. Nese ho `tasks`,
// `photos` a `photoPins`; zapisovat se smí jen pravdivě (viz `taskVisibilityOk`
// a `linkedVisibilityOk`).
// ---------------------------------------------------------------------------
//
// Membership source of truth lives on the top-level /projects/{pid} document:
//   { workspaceId: string, memberIds: string[], roles: { [uid]: reader|viewer|editor|admin } }
// Workspace-level admins live on /workspaces/{wid}: { ownerId, adminIds }.
// Invites are bearer tokens under /workspaces/{wid}/invites/{inviteId} and are
// redeemed atomically (invite claim + members doc + project membership arrays
// in a single batch enforced via getAfter()).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Shared helpers
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function uid() {
      return request.auth.uid;
    }

    // Stabilní federovaný subjekt napříč per-firma Firebase projekty.
    // Firebase přiděluje JINÉ request.auth.uid v každém projektu pro téhož
    // OIDC uživatele, takže membership/autorizace musí klíčovat federovaným
    // subjektem, ne uid. Pokud token nese identitu z provideru
    // 'oidc.openbuildos' (neprázdný list), vrátíme její první prvek; jinak
    // (dev e-mail/heslo, anonymous, … žádné identities) fallback na uid.
    // Pozn.: rules nemají snadné `in` na klíče mapy, proto čteme přes
    // .get('identities', {}).get('oidc.openbuildos', []) a kontrolujeme size().
    function principal() {
      return request.auth.token.firebase
          .get('identities', {})
          .get('oidc.openbuildos', []).size() > 0
        ? request.auth.token.firebase.identities['oidc.openbuildos'][0]
        : request.auth.uid;
    }

    function wsPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid);
    }

    function wsData(wid) {
      return get(wsPath(wid)).data;
    }

    function isWsOwner(wid) {
      return isRealUser()
        && exists(wsPath(wid))
        && wsData(wid).get('ownerId', '') == principal();
    }

    function isWsAdmin(wid) {
      return isRealUser()
        && exists(wsPath(wid))
        && (wsData(wid).get('ownerId', '') == principal()
            || principal() in wsData(wid).get('adminIds', []));
    }

    function projectPath(pid) {
      return /databases/$(database)/documents/projects/$(pid);
    }

    function projectData(pid) {
      return get(projectPath(pid)).data;
    }

    function projectInWorkspace(wid, pid) {
      return exists(projectPath(pid))
        && projectData(pid).get('workspaceId', '') == wid;
    }

    function projectRole(pid) {
      return projectData(pid).get('roles', {}).get(principal(), '');
    }

    function isProjectMember(wid, pid) {
      return isRealUser()
        && projectInWorkspace(wid, pid)
        && (principal() in projectData(pid).get('memberIds', [])
            || isWsAdmin(wid));
    }

    // ---------------------------------------------------------------------
    // MODEL OPRÁVNĚNÍ (#506, fáze 2) — skládaná MNOŽINA, ne žebříček
    //
    // Dosud byla role stupeň na škále: kdo chtěl vyšší úkon, musel mít i
    // všechna nižší práva. Kvůli tomu KONTROLNÍ role nemohla provést KONTROLNÍ
    // ÚKON — TDI/projektant, který má jen schvalovat, potřeboval editační právo
    // k cizímu obsahu, jinak mu pravidla odmítla ověření úkolu (a povýšení
    // schváleného výkresu do Plánů).
    //
    //   read       vidí projekt (= členství; nikdy se neodebírá)
    //   contribute zakládá VLASTNÍ obsah a mění JEN svůj
    //   edit       mění CIZÍ obsah
    //   certify    schvaluje revize dokumentů a ověřuje úkoly (verified)
    //   publish    vydává do OFICIÁLNÍ dokumentace
    //   manage     spravuje členy a nastavení projektu
    //
    // 🔑 `certify` NEVYŽADUJE `edit`. To je celý smysl přestavby.
    //
    // Zdroje: role z `projects/{pid}.roles[principal]` (jediný zdroj, který
    // vynucují pravidla) + dva ORTOGONÁLNÍ flagy ze zrcadla členů
    // (`canApprove` → certify, `canPublishOfficial` → publish). Vlastník/admin
    // firmy má na svých projektech vše.
    //
    // ⚠️ ZRCADLO tohohle modelu na klientu je `src/lib/permissions/projectPermissions.ts`.
    // Když měníš jedno, měň obojí — a přidej rules test do tests/rules/firestore.permissions.test.ts.
    // ---------------------------------------------------------------------

    // Migrační tabulka role → množina oprávnění (#506: „nikomu nic nevezme").
    //
    // ⚠️ `editor` má i `publish`: do #506 publikoval do oficiální dokumentace
    // IMPLICITNĚ (helper `canPublishOfficial` = `canEditContent || flag`).
    // Odebrat mu to by rozbilo hlavní cestu nahrávání dokumentů.
    //
    // 🪦 `company_lead` je ZRUŠENÁ role (#506) — nově ji nejde přiřadit (chybí
    // v allowlistu zrcadla členů níž). Tabulka ji drží JEN kvůli existujícím
    // datům v `projects/{pid}.roles`, ať o práva nepřijde nikdo, komu se do dat
    // dostala. Migrace dle zadání: read + contribute + edit.
    //
    // Neznámá / chybějící role se chová jako `viewer` — přesně jako dosud
    // (`canCreateContent` stálo na pouhém členství). Fail-safe DOLŮ nejdeme:
    // členovi s legacy hodnotou v `roles` bychom vzali zakládání obsahu.
    function rolePermissions(role) {
      return role == 'admin'
          ? ['read', 'contribute', 'edit', 'certify', 'publish', 'manage']
        : role == 'editor'
          ? ['read', 'contribute', 'edit', 'publish']
        : role == 'company_lead'
          ? ['read', 'contribute', 'edit']
        : role == 'reader'
          ? ['read']
        : ['read', 'contribute'];
    }

    function memberMirrorPath(wid, pid) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/members/$(principal());
    }

    // Ortogonální oprávnění z flagů na zrcadle členů. `exists()` je tu schválně:
    // bez něj by `get()` na chybějící dokument byl chybový výraz a jeho
    // vyhodnocení by záviselo na pořadí větví v `||`. Cesta se v rámci requestu
    // cachuje, takže je to nejvýš jedno čtení navíc.
    function memberFlagPermissions(wid, pid) {
      return exists(memberMirrorPath(wid, pid))
        ? (get(memberMirrorPath(wid, pid)).data.get('canApprove', false) == true
             ? ['certify'] : [])
          .concat(get(memberMirrorPath(wid, pid)).data.get('canPublishOfficial', false) == true
             ? ['publish'] : [])
        : [];
    }

    // 🔴 VÝKONNOSTNÍ MEZ: Firestore vyhodnotí nejvýš 1000 výrazů na požadavek.
    // Množina se proto počítá JEDNOU a dál se PŘEDÁVÁ jako seznam
    // (`hasAny([...])`), místo aby se pro každé oprávnění volal zvlášť gate.
    // Naivní varianta (`canEdit() || canCertify() || canPublish()`) ten strop
    // přerazila hned u prvního složeného pravidla — a selhala jako
    // permission-denied, tedy k nerozeznání od chybějícího práva.
    // ---------------------------------------------------------------------
    // ZMRAZENÍ STAVBY PO DOBU PŘEDÁNÍ (`projects/{pid}.handover.state`)
    //
    // Předání stavby novému vlastníkovi kopíruje obsah do jiného prostoru
    // a teprve pak překlopí `workspaceId`. Zápis, který mezitím přistane
    // v PŮVODNÍM místě, by se do kopie nedostal a po překlopení by zmizel —
    // proto je stavba po tu dobu JEN KE ČTENÍ.
    //
    // ⭐ VISÍ NA ZÁPISOVÝCH TRYCHTÝŘÍCH (`canCreateContent` / `canModifyContent`),
    // ne na `permsOf()`. Do `permsOf()` to patřilo logicky — je to jediné místo,
    // kudy prochází všechna obsahová práva — jenže tím by jedno čtení navíc
    // platila i cesta POZVÁNEK, a ta je na stropu přístupů k dokumentům už dnes
    // (`redeemOk` výš to popisuje). Dvě pravidla o pozvánkách na to okamžitě
    // spadla. Tady se zmrazení ptáme AŽ ZA oprávněním, takže čtení navíc zaplatí
    // jen zápis, který by jinak prošel — a čtení stavby nezdraží vůbec (výkres
    // na stavbě musí jít otevřít i uprostřed předání).
    //
    // ⚠️ NA STORAGE TOHLE NEDOSÁHNE — tam se rozhoduje z claims a Firestore
    // odtud vidět není. Blob se tedy nahrát může; jeho DOKUMENT ale ne, takže
    // fotka zůstane v offline frontě a doběhne až po překlopení, do nového
    // místa. Invariant „nafocená fotka se nikdy nezahodí" tím platí dál.
    //
    // 🔴 Pole píše VÝHRADNĚ server (viz denylisty u `projects/{pid}` níž).
    // Kdyby na něj dosáhl klient, měl by správce stavby vypínač „nikdo tu
    // nesmí psát" — a naopak by si mohl zmrazení sundat uprostřed kopie.
    // 🔴 `is map` NENÍ OZDOBA. `.get('handover', {})` vrátí výchozí hodnotu jen
    // když pole CHYBÍ — když tam leží `null` (typický způsob, jak by ho někdo
    // „vyprázdnil"), vrátí `null` a `.get('state', …)` nad ním skončí chybou,
    // tedy zamítnutím. Bez téhle zkoušky by jeden špatně napsaný úklid zamkl
    // zápisy na stavbě natrvalo — a to je přesně to, co se nesmí stát:
    // porucha v předání nesmí nikomu zamknout data. Vadné pole proto znamená
    // NEZMRAZENO, ne „zmrazeno pro jistotu".
    //
    // 🔴 A PROTO TU JE I `frozenUntil`. Zmrazení sundává úklid uvnitř funkce,
    // jenže když runtime funkci ukončí na timeoutu, žádný úklid se nespustí —
    // a `moving` by zůstalo navždy. Klient to pole přepsat nesmí (denylist
    // níž), návrh ve stavu `moving` zrušit nejde, takže by stavba byla do
    // ručního zásahu přes Admin SDK zamrzlá. Pravidla proto zmrazení uznávají
    // jen DO uvedeného času; potom se na stavbě zase pracuje, i kdyby se
    // o tom server nikdy nedozvěděl. Chybějící nebo nečasový údaj = nezmrazeno,
    // ze stejného důvodu jako u `is map`.
    // ⚠️ `let`, ne čtyři opisy `projectData(pid)`. Každý opis se VYHODNOTÍ jako
    // další přístup k dokumentu a rozpočet je společný pro celou dávku — přesně
    // na tom už jednou stála pravidla o pozvánkách (viz `redeemOk` výš).
    // 🔴 ČTE SE PŘES `get(...)`, NE `projectData(...)`, A JE TO NOSNÉ.
    // `projectData` sahá rovnou na `.data`, což nad NEEXISTUJÍCÍM dokumentem
    // skončí chybou — tedy zamítnutím. Jenže členský zrcadlový doklad se
    // zakládá v TÉŽE DÁVCE jako sama stavba (bootstrap, viz `canManageAfter`),
    // takže v tu chvíli `projects/{pid}` ještě neexistuje a zakládání stavby by
    // přestalo jít úplně. Stavba, která ještě není, zmrazená být nemůže.
    function projectFrozen(pid) {
      let project = get(projectPath(pid));
      let handover = project == null ? {} : project.data.get('handover', {});
      return handover is map
        && handover.get('state', '') == 'moving'
        && handover.get('frozenUntil', null) is timestamp
        && request.time < handover.frozenUntil;
    }

    function permsOf(wid, pid) {
      return isProjectMember(wid, pid)
        ? (isWsAdmin(wid)
            ? ['read', 'contribute', 'edit', 'certify', 'publish', 'manage']
            : rolePermissions(projectRole(pid)).concat(memberFlagPermissions(wid, pid)))
        : [];
    }

    // Jednorázová kontrola jednoho oprávnění. Pro pravidla, která jich testují
    // víc, si vyzvedni seznam přes `permsOf()` a předej ho dál.
    function hasPerm(wid, pid, perm) {
      return permsOf(wid, pid).hasAny([perm]);
    }

    function canContribute(wid, pid) {
      return hasPerm(wid, pid, 'contribute');
    }

    function canEdit(wid, pid) {
      return hasPerm(wid, pid, 'edit');
    }

    function canCertify(wid, pid) {
      return hasPerm(wid, pid, 'certify');
    }

    function canPublish(wid, pid) {
      return hasPerm(wid, pid, 'publish');
    }

    function canManage(wid, pid) {
      return hasPerm(wid, pid, 'manage');
    }

    // Bootstrap-friendly variant: also lets admins create a project and its
    // members docs in one atomic batch. The post-state branch only applies
    // when the project doc did NOT exist before the batch -- in that case the
    // batched /projects create was itself validated (workspace admin with
    // roles[uid] == 'admin'). For pre-existing projects only the pre-state
    // role counts, so an invite redeem cannot escalate itself to admin.
    function canManageAfter(wid, pid) {
      return canManage(wid, pid)
        || (isRealUser()
            && !exists(projectPath(pid))
            && getAfter(projectPath(pid)).data.get('workspaceId', '') == wid
            && getAfter(projectPath(pid)).data.get('roles', {}).get(principal(), '') == 'admin');
    }

    // ---------------------------------------------------------------------
    // Company / role model (per-project company assignment)
    //
    // A project doc may carry a `companies` map { [principal]: companyId }.
    // The `company_lead` role lets a member edit content authored by other
    // members of the SAME company on that project (in addition to their own).
    // ---------------------------------------------------------------------

    // The company a given member is assigned to on a project (or '' if none).
    function memberCompany(pid, who) {
      return projectData(pid).get('companies', {}).get(who, '');
    }

    // ---------------------------------------------------------------------
    // PRŮKAZNÁ VIDITELNOST PRO `list` (nález A1 — viz hlavička souboru)
    //
    // `visibility` je JEDINÉ pole, kterým se uvnitř stavby rozlišuje, kdo obsah
    // vidí. Čte se PŘÍMO (ne přes `.get()`), takže dotaz, který ho nezúží,
    // skončí chybou → deny. Klient proto posílá dva dotazy: `visibility == ''`
    // (obsah celé stavby) a `visibility == <moje firma>` (interní).
    //
    // Prázdná firma volajícího splyne s první větví — nic navíc mu to nedá.
    // ---------------------------------------------------------------------
    function visibleInList(pid) {
      return resource.data.visibility == ''
        || resource.data.visibility == memberCompany(pid, principal());
    }

    function isSameProjectCompany(wid, pid, companyId) {
      return companyId != ''
        && isProjectMember(wid, pid)
        && memberCompany(pid, principal()) == companyId;
    }

    // Vedoucí firemního prostoru = člen TÉŽE Company, který smí měnit cizí obsah.
    // Dřív to byl výčet rolí ['company_lead','editor','admin']; po zrušení
    // `company_lead` (#506) je to prostě oprávnění `edit` — legacy nositelé role
    // ho podle migrační tabulky mají dál, takže se nikomu nic nemění.
    function isCompanySpaceLead(wid, pid, companyId) {
      return isSameProjectCompany(wid, pid, companyId)
        && canEdit(wid, pid);
    }

    // ⚠️ VOLÁ SE `canEdit`, NE `isCompanySpaceLead`, a je to úspora, ne úlitba.
    // `isCompanySpaceLead` = `isSameProjectCompany && canEdit` — jenže
    // `isSameProjectCompany` je o řádek výš už ověřená, takže by se celá (včetně
    // `projectData` a `memberCompany`) vyhodnotila podruhé. Význam je totožný,
    // cena poloviční. Viz strop 1 000 výrazů na požadavek níž.
    function hasCompanyResourceAccess(wid, pid, companyId, data) {
      return isSameProjectCompany(wid, pid, companyId)
        && (
          canEdit(wid, pid)
          || data.get('accessMode', '') == 'company_all'
          || (data.get('accessMode', '') == 'restricted'
              && principal() in data.get('allowedPrincipalIds', []))
        );
    }

    /**
     * Pouští obsah sám sebou: `company_all` vidí celá firma, `restricted` jen
     * vyjmenovaní. Čistě nad daty — bez čtení dokumentů a bez `permsOf`, takže
     * se dá volat opakovaně bez ceny.
     */
    function companyDataOpen(data) {
      return data.get('accessMode', '') == 'company_all'
        || (data.get('accessMode', '') == 'restricted'
            && principal() in data.get('allowedPrincipalIds', []));
    }

    /**
     * Smí volající ZMĚNIT nebo SMAZAT tenhle firemní obsah? Cizí smí vedoucí
     * prostoru, vlastní jeho autor — a jen dokud k němu má přístup.
     *
     * Nahradilo dvojici `hasCompanyResourceAccess(…) && (createdBy == principal()
     * || isCompanySpaceLead(…))`, kde se `permsOf` počítalo dvakrát. Význam je
     * totožný: po dosazení `isCompanySpaceLead = isSameProjectCompany && canEdit`
     * a při už ověřené příslušnosti k firmě se výraz zjednoduší přesně na tohle.
     */
    function canModifyCompanyResource(wid, pid, companyId, data) {
      return isSameProjectCompany(wid, pid, companyId)
        && (
          canEdit(wid, pid)
          || (data.get('createdBy', '') == principal() && companyDataOpen(data))
        );
    }

    /**
     * ZÁPIS DO FIREMNÍ SLOŽKY jednou funkcí — a `let` je tu to podstatné.
     *
     * 🔴 PROČ TO NEJDE SKLÁDAT Z MENŠÍCH KOUSKŮ V PRAVIDLE. Větev `allow` neumí
     * `let`, takže každá konjunkce vyhodnotí svůj podstrom znovu. Úprava
     * dokumentu potřebuje vědět dvě věci — smí ten člověk MĚNIT tenhle obsah
     * a smí ho DÁT DO té složky — a obě stojí na tomtéž `permsOf`. Napsané
     * zvlášť se počítalo dvakrát (s původním třetím opisem třikrát) a přeteklo
     * to strop 1 000 vyhodnocených výrazů na požadavek: úprava přestala jít
     * úplně a hlásila `permission-denied` (#639). Uvnitř funkce se právo
     * spočítá JEDNOU do `let` a použije se na obě otázky.
     */
    function canWriteCompanyResourceInto(wid, pid, companyId, folderId, before, after) {
      let lead = isSameProjectCompany(wid, pid, companyId) && canEdit(wid, pid);
      let folder = folderId != '' && exists(companyFolderPath(wid, pid, companyId, folderId))
        ? get(companyFolderPath(wid, pid, companyId, folderId)).data
        : null;
      return isSameProjectCompany(wid, pid, companyId)
        && (lead || (before.get('createdBy', '') == principal() && companyDataOpen(before)))
        && (
          (
            folderId == ''
            && after.get('accessMode', '') == 'company_all'
            && after.get('allowedPrincipalIds', []).size() == 0
          ) || (
            folder != null
            && (lead || companyDataOpen(folder))
            && after.get('accessMode', '') == folder.get('accessMode', '')
            && after.get('allowedPrincipalIds', []) == folder.get('allowedPrincipalIds', [])
          )
        );
    }

    /**
     * Totéž pro ANOTACE nad firemním plánem: přístup se počítá jednou do `let`
     * a použije se na obojí — na anotace i na plán, do kterého patří.
     *
     * ⚠️ Anotace nemají větev „autor smí svoje": kdo do plánu vidí, kreslí do
     * něj. Proto je podmínka o jednu možnost kratší než u dokumentů.
     */
    function canWriteCompanyAnnotationsInto(wid, pid, companyId, planId, before, after) {
      let lead = isSameProjectCompany(wid, pid, companyId) && canEdit(wid, pid);
      let plan = planId != '' && exists(companyPlanPath(wid, pid, companyId, planId))
        ? get(companyPlanPath(wid, pid, companyId, planId)).data
        : null;
      return isSameProjectCompany(wid, pid, companyId)
        && (lead || companyDataOpen(before))
        && plan != null
        && (lead || companyDataOpen(plan))
        && after.get('folderId', '') == plan.get('folderId', '')
        && after.get('accessMode', '') == plan.get('accessMode', '')
        && after.get('allowedPrincipalIds', []) == plan.get('allowedPrincipalIds', []);
    }

    function validCompanyResourceIdentity(companyId, data) {
      return data.get('scope', '') == 'company_internal'
        && data.get('ownerCompanyId', '') == companyId
        && data.get('createdBy', '') == principal()
        && data.get('accessMode', '') in ['company_all', 'restricted']
        && data.get('allowedPrincipalIds', []) is list;
    }

    function companyFolderPath(wid, pid, companyId, folderId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/companySpaces/$(companyId)/folders/$(folderId);
    }

    function companyPlanPath(wid, pid, companyId, planId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/companySpaces/$(companyId)/plans/$(planId);
    }

    // 🔴 JEDNA VAZBA MÍSTO ČTYŘ OPISŮ `get(...)`. Firestore má na požadavek strop
    // 1 000 VYHODNOCENÝCH VÝRAZŮ (vedle stropu 10 přístupů k dokumentům) a každý
    // opis `get(companyPlanPath(...))` znamená znovu sestavit cestu ze čtyř
    // interpolací a znovu projít celý podvýraz. Přesně na tenhle strop dojelo
    // nahrávání dokumentů do firemní složky — pravidlo padalo na
    // `EvaluationException: maximum of 1000 expressions`, tedy hlášením
    // k nerozeznání od chybějícího oprávnění. Táž úvaha jako u `redeemOk` výš.
    function canUseCompanyPlan(wid, pid, companyId, planId, data) {
      let plan = planId != '' && exists(companyPlanPath(wid, pid, companyId, planId))
        ? get(companyPlanPath(wid, pid, companyId, planId)).data
        : null;
      return plan != null
        && hasCompanyResourceAccess(wid, pid, companyId, plan)
        && data.get('folderId', '') == plan.get('folderId', '')
        && data.get('accessMode', '') == plan.get('accessMode', '')
        && data.get('allowedPrincipalIds', []) == plan.get('allowedPrincipalIds', []);
    }

    /** Tentýž důvod pro jednu vazbu jako u `canUseCompanyPlan` výš. */
    function canUseCompanyFolder(wid, pid, companyId, folderId, data) {
      let folder = folderId != '' && exists(companyFolderPath(wid, pid, companyId, folderId))
        ? get(companyFolderPath(wid, pid, companyId, folderId)).data
        : null;
      return (
          folderId == ''
          && data.get('accessMode', '') == 'company_all'
          && data.get('allowedPrincipalIds', []).size() == 0
        ) || (
          folder != null
          && hasCompanyResourceAccess(wid, pid, companyId, folder)
          && data.get('accessMode', '') == folder.get('accessMode', '')
          && data.get('allowedPrincipalIds', []) == folder.get('allowedPrincipalIds', [])
        );
    }

    /**
     * Smí nová/upravená složka viset pod `parentId`? Řeší JEN slučitelnost
     * přístupů, ne oprávnění volajícího.
     *
     * 🔴 SCHVÁLNĚ SE TU NEPTÁ NA `hasCompanyResourceAccess`. Obě volající větve
     * (zakládání i úprava složky) mají o řádek výš `isCompanySpaceLead`, a ten
     * je silnější: vedoucí firemního prostoru projde `hasCompanyResourceAccess`
     * vždycky, větví `canEdit`. Byla to tedy kontrola, která nikdy nic
     * nezamítla — zato pokaždé znovu spočítala `permsOf` se vším, co k tomu
     * patří. Na stropu 1 000 vyhodnocených výrazů na požadavek to nebyl luxus:
     * zakládání podsložky kvůli tomu padalo. Viz #639.
     *
     * ⚠️ Kdo tuhle funkci zavolá odjinud než z větve chráněné
     * `isCompanySpaceLead`, musí si přístup k rodiči ověřit sám.
     */
    function validChildCompanyAccess(wid, pid, companyId, parentId, data) {
      let parent = parentId != '' && exists(companyFolderPath(wid, pid, companyId, parentId))
        ? get(companyFolderPath(wid, pid, companyId, parentId)).data
        : null;
      return (
          parentId == ''
          && data.get('accessMode', '') in ['company_all', 'restricted']
        ) || (
          parent != null
          && (
            parent.get('accessMode', '') == 'company_all'
            || (
              data.get('accessMode', '') == 'restricted'
              && parent.get('allowedPrincipalIds', []).hasAll(data.get('allowedPrincipalIds', []))
            )
          )
        );
    }

    // Content is authored by the caller (createdBy == principal).
    function authoredBySelf() {
      return resource.data.get('createdBy', '') == principal();
    }

    // Změna/smazání existujícího obsahu: cizí smí `edit`, vlastní `contribute`.
    // (Firemní větev pro `company_lead` zanikla — legacy nositelé té role mají
    // podle migrační tabulky rovnou `edit`, tedy víc, ne míň.)
    function canModifyWith(perms) {
      return perms.hasAny(['edit'])
        || (perms.hasAny(['contribute']) && authoredBySelf());
    }

    function canModifyContent(wid, pid) {
      // Pořadí je úmyslné: `projectFrozen` stojí jedno čtení navíc, a to se
      // vyhodnotí jen u zápisu, který by jinak prošel.
      return canModifyWith(permsOf(wid, pid)) && !projectFrozen(pid);
    }

    // Založení obsahu = `contribute`. Author (createdBy) musí být buď
    // PRÁZDNÝ (obsah ještě nezadrátovaný na authorship → editovatelný jen
    // přes `edit`, bezpečné), nebo SÁM volající (principal) — nikdy NĚKDO JINÝ
    // (zákaz spoofingu autorství). Tím se žádný create nerozbije, i kdyby daná
    // kolekce createdBy nestampovala.
    function canCreateWith(perms) {
      return perms.hasAny(['contribute'])
        && (request.resource.data.get('createdBy', '') == ''
            || request.resource.data.get('createdBy', '') == principal());
    }

    function canCreateContent(wid, pid) {
      return canCreateWith(permsOf(wid, pid)) && !projectFrozen(pid);
    }

    // Anti-spoof atribuce firmě u oficiálních dokumentů: `ownerCompanyId` na create
    // smí být buď prázdný (bez atribuce), VLASTNÍ firma volajícího, NEBO cokoli,
    // pokud volající smí měnit cizí obsah (`edit`) — ten je důvěryhodný správce
    // obsahu a legitimně přeřazuje/publikuje napříč firmami (např. rozdělení chybně
    // spárovaného dokumentu). Omezení „jen vlastní firma" tak reálně drží pro
    // publishera bez `edit`. Čte z `projects/{pid}.companies`.
    function validOfficialOwnerCompany(perms, pid) {
      return request.resource.data.get('ownerCompanyId', '') == ''
        || request.resource.data.get('ownerCompanyId', '') == memberCompany(pid, principal())
        || perms.hasAny(['edit']);
    }

    // Založení oficiálního dokumentu / revize: `publish` + anti-spoof firmy
    // a autorství. Jedno vyhodnocení množiny na celé pravidlo.
    function officialCreateOk(perms, pid) {
      return perms.hasAny(['publish'])
        && validOfficialOwnerCompany(perms, pid)
        && authorNotSpoofedOnCreate();
    }

    // Update dokumentu: běžná práva k obsahu, NEBO — u `certify`/`publish` bez
    // `edit` — jen přepnutí platné revize jako vedlejší efekt schválení/uploadu.
    function documentUpdateOk(perms) {
      return canModifyWith(perms)
        || (perms.hasAny(['certify', 'publish'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['currentVersionId', 'updatedAt']));
    }

    // Update revize dokumentu.
    //
    // `certify` zapisuje SVÉ ROZHODNUTÍ: `approvals` mapu, odvozený status
    // (i supersede předchozí verze) a razítko recenzenta.
    //
    // 🔴 Nález R5 (#506): tahle větev dřív NEMĚLA žádné omezení polí, takže
    // schvalovatel — třeba člen jinak bez práva na cizí obsah — směl u
    // libovolné verze přepsat `filePath`, `versionLabel` i `documentId`.
    // Schvalovací právo tak bylo MOCNĚJŠÍ než editorské, přestože ho smí
    // rozdat i projektový admin, který role měnit nesmí. Teď je uzavřené
    // `hasOnly` na pole rozhodnutí — přesně to, co zapisuje `documentService.ts`
    // (`updateVersionStatus` / `recordApprovalDecision`).
    //
    // Ostatní (uploader/editor/autor) smí běžné editace, ale NE přechod do
    // rozhodnutí (zákaz self-approve). Audit se v rules nevynucuje.
    function versionUpdateOk(perms) {
      return (perms.hasAny(['certify'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'approvals', 'reviewedBy', 'reviewedByName',
               'reviewedAt', 'reviewerComment', 'updatedAt'
             ]))
        || (canModifyWith(perms)
            && !(request.resource.data.status != resource.data.status
                 && request.resource.data.status in ['approved', 'approved_with_comments', 'rejected', 'superseded', 'for_construction']));
    }

    // Autor obsahu na create nesmí být podvržený: `createdBy` je prázdný nebo přímo
    // volající (principal), nikdy někdo jiný. Zrcadlí invariant `canCreateContent`,
    // který jsme u oficiálních dokumentů/verzí nahradili gate `canPublishOfficial`
    // — bez tohohle by publisher mohl podvrhnout autorství (a získat edit-own).
    function authorNotSpoofedOnCreate() {
      return request.resource.data.get('createdBy', '') == ''
        || request.resource.data.get('createdBy', '') == principal();
    }

    // ---------------------------------------------------------------------
    // Workspaces
    // ---------------------------------------------------------------------

    match /workspaces/{wid} {
      // The id is not secret; the doc only carries owner/admin metadata.
      allow get: if isRealUser();
      allow list: if false;
      // Bootstrap claim: first creator becomes owner (keyed by principal).
      allow create: if isRealUser()
        && request.resource.data.ownerId == principal()
        && request.resource.data.adminIds is list;
      // Owner can manage admins/name and workspace settings (modules,
      // storageBackend, ...) but never transfer/drop ownership here.
      // Workspace admins may update settings too, WITHOUT escalation:
      // ownerId and adminIds must stay unchanged (the admin list is
      // owner-only).
      allow update: if isRealUser()
        && (
          (resource.data.get('ownerId', '') == principal()
            && request.resource.data.ownerId == resource.data.ownerId)
          || (isWsAdmin(wid)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.adminIds == resource.data.adminIds)
        );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // ÚČASTNÍK FIRMY (nález E, #535)
    //
    // Firemní adresář i seznam firem měly `allow read: if isRealUser()` —
    // komentář nad nimi říkal „any real user (firm member)", ale ta závorka se
    // do podmínky nikdy nedostala. V per-firma nasazení to bylo neškodné (cizí
    // do projektu nedosáhl vůbec); v HOSTOVANÉM modelu jsou všechny firmy
    // v jednom Firebase projektu, takže to byl únik PŘES HRANICI ZÁKAZNÍKA:
    // kdokoli přihlášený si vypsal jména a e-maily lidí libovolné firmy.
    //
    // Bránou je teď adresářový záznam. Ten do #535 nic nedokazoval (zapsal si
    // ho kdokoli sám na sebe — nález E2), proto se opravuje SPOLU se zápisem
    // níž: založit ho smí jen člen některé stavby té firmy. Teprve tím se
    // z „existuje záznam" stává použitelný fakt.
    //
    // ⚠️ Odebrání ze STAVBY tenhle záznam neruší (člověk může být na dalších
    // stavbách firmy) — do adresáře tedy vidí, dokud ho firma nesmaže. To je
    // záměr: „odebrat z firmy" = smazat adresářový záznam, což smí jen
    // vlastník/admin firmy.
    // ---------------------------------------------------------------------

    function firmDirectoryPath(wid, who) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(who);
    }

    function isFirmParticipant(wid) {
      return isRealUser()
        && (isWsAdmin(wid) || exists(firmDirectoryPath(wid, principal())));
    }

    match /workspaces/{wid}/companies/{companyId} {
      allow read: if isFirmParticipant(wid);
      allow create, update, delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Firm member directory (workspace-level, keyed by principal)
    //
    // Čte účastník firmy (viz výš); spravuje vlastník/admin firmy. Vlastní
    // záznam si člověk smí ZALOŽIT jen tehdy, když opravdu je členem některé
    // stavby té firmy — a musí tu stavbu DEKLAROVAT polem `viaProjectId`.
    //
    // 🔑 Proč deklarace: rules neumí zjistit „je členem NĚJAKÉ stavby tohohle
    // workspace" (nejde iterovat kolekci). Stejný vzor jako `roleChangeTarget`
    // u #530: zápis sám řekne, o kterou stavbu se opírá, a pravidla tu
    // deklaraci ověří. Lhát se nedá — na cizí stavbě členem není.
    // Stojí to jedno čtení navíc, a jen při ZALOŽENÍ záznamu (redeem).
    //
    // `update` deklaraci nepotřebuje: existující záznam už jednou touto branou
    // prošel, takže si vlastní jméno/profil smí měnit dál (`voiceUserConsent`,
    // `joinConsent`, přejmenování).
    //
    // ⚠️ `membershipKind`/`workspaceRole` v záznamu zůstávají POPISNÉ a
    // falšovatelné — žádné pravidlo se jich neptá (viz membershipClaims.ts).
    // ---------------------------------------------------------------------

    function directorySelfCreateOk(wid, memberPrincipal) {
      return principal() == memberPrincipal
        && request.resource.data.get('viaProjectId', '') != ''
        && isProjectMember(wid, request.resource.data.get('viaProjectId', ''));
    }

    match /workspaces/{wid}/members/{memberPrincipal} {
      allow read: if isFirmParticipant(wid);
      allow create: if isWsAdmin(wid) || directorySelfCreateOk(wid, memberPrincipal);
      allow update: if isWsAdmin(wid)
        || (isRealUser() && principal() == memberPrincipal);
      allow delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Signál invalidace custom claims (docs/SECURITY_CLAIMS_DESIGN.md kap. 3)
    //
    // Autorizace Storage jede přes custom claims v tokenu. Token má pevnou
    // platnost 1 h a nejde zkrátit, takže po změně členství by claims mohly být
    // až hodinu zastaralé. Tenhle dokument je SIGNÁL: klient sleduje TEN SVŮJ
    // a při každé změně `rev` si vynutí `getIdToken(true)` → nové claims má
    // během sekund. Zapisuje ho Cloud Function `syncMemberClaims`, případně
    // admin klientsky.
    //
    // Číst smí JEN dotčený principal — z cizího signálu by šlo odvodit, že
    // někdo je členem téhle firmy.
    //
    // Zapisovat smí JEN vlastník/admin firmy. Běžnou cestou ho stejně píše
    // `syncMemberClaims` přes Admin SDK (rules obchází), takže klientský zápis
    // je jen doplněk.
    //
    // ⚠️ Původní verze pouštěla i „firemního člena" přes existenci dokumentu
    // `workspaces/{wid}/members/{principal}`. Ten ale zakládá `redeemInvite`
    // KAŽDÉMU pozvanému včetně hosta z cizí firmy — takže by to nebyla brána,
    // ale otevřená vrátka: kdokoli pozvaný by mohl cizím lidem vynucovat obnovu
    // tokenu (šum + náklady na Cloud Functions).
    // ---------------------------------------------------------------------

    function validAccessSignal() {
      return request.resource.data.keys().hasOnly(['rev', 'updatedAt', 'reason'])
        && request.resource.data.rev is int
        && request.resource.data.rev >= 0;
    }

    match /workspaces/{wid}/accessSignals/{signalPrincipal} {
      allow get: if isRealUser() && principal() == signalPrincipal;
      allow list: if isWsAdmin(wid);
      allow create, update: if isWsAdmin(wid) && validAccessSignal();
      allow delete: if isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Invites (bearer token documents)
    // ---------------------------------------------------------------------

    function invitePath(wid, inviteId) {
      return /databases/$(database)/documents/workspaces/$(wid)/invites/$(inviteId);
    }

    // The members/{uid} self-join create is only valid when the same batch
    // claims the referenced invite (getAfter forces atomicity).
    // ⚠️ STROP 1000 VÝRAZŮ. Dokumentový přístup se v rámci požadavku kešuje,
    // ale KAŽDÉ opsané `get(invitePath(...))` se pořád VYHODNOCUJE — včetně
    // sestavení cesty ze dvou interpolací. Šest opisů tady stálo šest průchodů.
    // Redeem přitom jede jako JEDNA dávka (pozvánka + členství + zrcadlo +
    // `projects/{pid}`) a rozpočet je společný pro celou dávku, takže se
    // vyčerpal dřív, než došlo na poslední dokument. Proto `let`: jedna vazba,
    // stejná sémantika, výrazně nižší cena.
    function redeemOk(wid, pid, inviteId, role) {
      let invite = get(invitePath(wid, inviteId)).data;
      return invite.projectId == pid
        && invite.usedBy == null
        && request.time < invite.expiresAt
        && role == invite.role
        // Only APPROVED invites are redeemable. Missing field == approved
        // (backward compat with pre-#367 invites).
        && invite.get('approvalStatus', 'approved') == 'approved'
        && getAfter(invitePath(wid, inviteId)).data.usedBy == principal();
    }

    // Firma z pozvánky, normalizovaná na řetězec. `redeemInvite` posílá
    // `companyId: null`, když pozvánka firmu nenese — bez normalizace by se
    // `null` neporovnalo s chybějícím polem na zrcadle a redeem by spadl.
    function inviteCompanyId(wid, inviteId) {
      let companyId = get(invitePath(wid, inviteId)).data.get('companyId', '');
      return companyId is string ? companyId : '';
    }

    // Táž normalizace na straně zrcadla členů.
    function stringOrEmpty(value) {
      return value is string ? value : '';
    }

    // Kdo smí pozvánku NAVRHNOUT: člen s `edit` (typicky Koordinátor / vedoucí
    // úseku), který ale nespravuje projekt. Pozvánka zůstane `pending_approval`,
    // dokud ji neschválí správce projektu / firmy (issue #367). Správci ji
    // zakládají rovnou přes `canManage` větev, tuhle nepotřebují.
    function canProposeInvite(wid, pid) {
      return canEdit(wid, pid);
    }

    match /workspaces/{wid}/invites/{inviteId} {
      // The invite id itself is the secret; any real user holding it may read.
      allow get: if isRealUser();
      allow list: if isWsAdmin(wid);
      allow create: if isRealUser()
        // Pozvánkou nejde udělit `admin` (eskalace) — jen role bez `manage`.
        && request.resource.data.role in ['reader', 'viewer', 'editor']
        && request.resource.data.usedBy == null
        // 🔑 Platnost je vlastnost SYSTÉMU, ne zvyk klienta. `createInvite()`
        // slibuje 14 dní (`INVITE_TTL_DAYS`) a `redeemOk` na `expiresAt` stojí
        // (`request.time < invite.expiresAt`) — jenže dokud rozsah nikdo
        // nekontroloval, směl si správce firmy vystavit pozvánku platnou do
        // roku 2099. Bearer token, který nikdy neztratí platnost, je přesně to,
        // před čím TTL má chránit: uniklý odkaz ze staré fotky chatu otevře
        // stavbu i za tři roky.
        //
        // Okno je totéž jako u centrálního registru (#549/#551), ať pozvánka a
        // její zrcadlo nemají každé jinou pravdu o téže expiraci. Den vůle nad
        // TTL je tam schválně — hodnotu počítá klient ze SVÝCH hodin a tvrdší
        // okno by u rozjetých hodin nechalo zvaní padat na permission-denied.
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(15, 'd')
        && request.resource.data.createdBy == principal()
        && (
            // Direct: project admin / workspace admin issues a live invite.
            (canManage(wid, request.resource.data.projectId)
              && request.resource.data.get('approvalStatus', 'approved') == 'approved')
            // Manager/company lead proposes an invite needing admin approval.
            || (canProposeInvite(wid, request.resource.data.projectId)
              && request.resource.data.approvalStatus == 'pending_approval')
        );
      allow update: if (
          // Redeem: only claiming an unused, unexpired, APPROVED invite for yourself.
          isRealUser()
          && resource.data.usedBy == null
          && resource.data.get('approvalStatus', 'approved') == 'approved'
          && request.time < resource.data.expiresAt
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == principal()
        )
        // Approve/reject + revoke: project admin / ws admin may edit the invite
        // (this also covers flipping approvalStatus pending_approval -> approved).
        //
        // 🔴 Nález B (#535): tahle větev se ptala na `resource.data.projectId`,
        // tedy na stavbu, ze které pozvánka ODCHÁZÍ — nikdy na tu, KAM po
        // zápisu míří. Zatímco `create` je gatovaný správně na CÍL, `update`
        // kontroloval opačný konec: správce stavby A si vystavil pozvánku na A,
        // přepsal `projectId` na B a uplatnil ji sám na sebe.
        //
        // `projectId` je proto u update ZMRAZENÝ. Je to levnější než
        // `canManage` na cíl (nula čtení navíc — a `redeemOk` sám vytěžuje
        // 7 z 10 dokumentových přístupů) a přesnější: pozvánka zůstane na
        // stavbě, pro kterou ji `create` schválil. Přesměrování není úkon,
        // který by kdokoli potřeboval — vystaví se nová.
        //
        // 🔑 Strop platnosti drží i tady, jinak by okno u `create` bylo ovladač
        // nad ničím: založ pozvánku na 14 dní, hned ji updatni na rok 2099.
        // Je to JEN strop, ne okno — zkrácení expirace do minulosti pozvánku
        // zneplatňuje, a to musí zůstat průchozí (klient dnes ruší mazáním,
        // ale zavírat cestu, která bezpečnost jen zvyšuje, nedává smysl).
        || (canManage(wid, resource.data.projectId)
            && request.resource.data.projectId == resource.data.projectId
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt < request.time + duration.value(15, 'd'));
      allow delete: if canManage(wid, resource.data.projectId);
    }

    // ---------------------------------------------------------------------
    // Project members mirror (UI metadata; rules read /projects instead)
    //
    // 🔴 Nález R1 (#506): tenhle allowlist byl JEDINÉ místo, které minul rename
    // `company_editor → company_lead`. Pravidla pouštěla `company_editor`, který
    // v `src/` neexistoval, a odmítala `company_lead`, který existoval — takže
    // se „Vedoucí úseku" zapsal do vynuceného `projects.roles`, ale ne do
    // zrcadla, a tentýž člověk měl na dvou obrazovkách dvě různé role.
    // Fáze 2 roli ruší úplně, takže tu není ani jeden z těch mrtvých názvů.
    //
    // `roleAssignable` = role, kterou lze NOVĚ přiřadit. Legacy hodnota (dnes
    // `company_lead`) smí v dokumentu ZŮSTAT — jinak by byl takový záznam
    // zamčený navždy a nešlo by u něj nastavit ani `canApprove` (probe P4).
    // ---------------------------------------------------------------------

    function roleAssignable(role) {
      return role in ['reader', 'viewer', 'editor', 'admin'];
    }

    function roleWriteOk() {
      return roleAssignable(request.resource.data.get('role', ''))
        || request.resource.data.get('role', '') == resource.data.get('role', '');
    }

    // Přeřazení v ZRCADLE musí říkat přesně totéž co větev na
    // `projects/{pid}.roles` (#507, viz `roleChangeOk` níž). Do teď se ty dvě
    // cesty rozcházely OPAČNĚ, než by člověk čekal: zrcadlo pouštělo
    // projektového správce i na `admin` a i sám na sebe, kdežto vynucovaná
    // `roles` mapa mu nedovolila nic. Zobrazovaná role tak šla nastavit tam,
    // kam vynucená ne — a to je horší stav než oba zákazy dohromady.
    //
    // Beze změny role (flagy `canApprove`/`canPublishOfficial`, displayName,
    // profese, firma) tahle branka nic neomezuje — ty smí projektový správce
    // dál (#506, nález R3).
    function mirrorRoleChangeOk(memberUid) {
      return request.resource.data.get('role', '') == resource.data.get('role', '')
        || (memberUid != principal()
            && resource.data.get('role', '') != 'admin'
            && request.resource.data.get('role', '') in ['reader', 'viewer', 'editor']);
    }

    match /workspaces/{wid}/projects/{pid}/members/{memberUid} {
      allow get, list: if isProjectMember(wid, pid);
      allow create: if (
          (
          // Self-join via invite redeemed in the same batch.
          // members/{id} doc is keyed by principal (federated subject or uid).
          isRealUser()
          && memberUid == principal()
          // `profession` (#506 fáze 3) je POPISNÁ — smí se nést pozvánkou, aby
          // „pozval jsem TDI" zůstalo pravdou i po přijetí. Oprávnění NEMĚNÍ:
          // `memberFlagPermissions` níž sahá výhradně na `canApprove` /
          // `canPublishOfficial`, a ty si sebe-připojující se dopsat NESMÍ —
          // proto v allowlistu nejsou a zůstávají na správci.
          && request.resource.data.keys()
              .hasOnly(['role', 'displayName', 'email', 'inviteId', 'joinedAt', 'companyId', 'profession'])
          && request.resource.data.role in ['reader', 'viewer', 'editor']
          && request.resource.data.get('profession', '') is string
          // 🔴 Nález C (#535): `companyId` tu bylo bez podmínky, takže si ho
          // sebe-připojující se vyplnil sám — a `inviteSelfJoin` z něj pak
          // odvozoval `projects/{pid}.companies`, tedy klíč k firemnímu
          // prostoru i interním úkolům. Firma se proto MUSÍ shodovat
          // s pozvánkou. `invitePath` už čte `redeemOk`, takže je to nula
          // dokumentových přístupů navíc.
          && stringOrEmpty(request.resource.data.get('companyId', ''))
              == inviteCompanyId(wid, request.resource.data.inviteId)
          && redeemOk(wid, pid, request.resource.data.inviteId,
              request.resource.data.role)
        ) || (
          canManageAfter(wid, pid)
          && roleAssignable(request.resource.data.get('role', ''))
        )
        ) && !projectFrozen(pid);
      // Vlastník/admin FIRMY má zrcadlo celé (včetně `admin` a sebe sama);
      // projektový správce jen tolik, kolik mu dává `roleChangeOk` na
      // `projects/{pid}.roles` — jinak by obě cesty říkaly každá něco jiného.
      allow update: if (
          canManageAfter(wid, pid)
        && roleWriteOk()
        && (isWsAdmin(wid) || mirrorRoleChangeOk(memberUid))
        ) && !projectFrozen(pid);
      allow delete: if (
          canManage(wid, pid)
        ) && !projectFrozen(pid);
    }

    // Firemní interní pracovní prostory jsou oddělené od oficiálních kolekcí,
    // aby legacy list query nikdy nemíchaly obsah s rozdílnou viditelností.
    match /workspaces/{wid}/projects/{pid}/companySpaces/{companyId} {
      allow get: if isSameProjectCompany(wid, pid, companyId);
      allow list: if false;
      allow create: if (
          (isSameProjectCompany(wid, pid, companyId) || canManage(wid, pid))
        && request.resource.data.get('companyId', '') == companyId
        && request.resource.data.get('projectId', '') == pid
        && request.resource.data.get('workspaceId', '') == wid
        && request.resource.data.get('scope', '') == 'company_internal'
        && request.resource.data.get('createdBy', '') == principal()
        ) && !projectFrozen(pid);
      allow update: if (
          isCompanySpaceLead(wid, pid, companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.workspaceId == resource.data.workspaceId
        && request.resource.data.scope == resource.data.scope
        ) && !projectFrozen(pid);
      allow delete: if false;

      match /folders/{folderId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if (
          isCompanySpaceLead(wid, pid, companyId)
          && validCompanyResourceIdentity(companyId, request.resource.data)
          && request.resource.data.get('folderId', '') == folderId
          && request.resource.data.get('parentId', '') != folderId
          && validChildCompanyAccess(wid, pid, companyId, request.resource.data.get('parentId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow update: if (
          isCompanySpaceLead(wid, pid, companyId)
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('folderId', '') == resource.data.get('folderId', '')
          && request.resource.data.get('parentId', '') != folderId
          && validChildCompanyAccess(wid, pid, companyId, request.resource.data.get('parentId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow delete: if (
          isCompanySpaceLead(wid, pid, companyId)
        ) && !projectFrozen(pid);
      }

      match /documents/{documentId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if (
          validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('documentId', '') == documentId
          && request.resource.data.get('approvalMode', '') == 'none'
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow update: if (
          canWriteCompanyResourceInto(
            wid, pid, companyId,
            request.resource.data.get('folderId', ''),
            resource.data,
            request.resource.data
          )
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('approvalMode', '') == 'none'
        ) && !projectFrozen(pid);
        allow delete: if (
          canModifyCompanyResource(wid, pid, companyId, resource.data)
        ) && !projectFrozen(pid);
      }

      match /documentVersions/{versionId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if (
          validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('versionId', '') == versionId
          && request.resource.data.get('status', '') == 'working'
          && request.resource.data.get('workflowMode', '') == 'none'
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow update: if (
          canWriteCompanyResourceInto(
            wid, pid, companyId,
            request.resource.data.get('folderId', ''),
            resource.data,
            request.resource.data
          )
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        ) && !projectFrozen(pid);
        allow delete: if (
          canModifyCompanyResource(wid, pid, companyId, resource.data)
        ) && !projectFrozen(pid);
      }

      match /plans/{planId} {
        allow get, list: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow create: if (
          validCompanyResourceIdentity(companyId, request.resource.data)
          && isSameProjectCompany(wid, pid, companyId)
          && request.resource.data.get('planId', '') == planId
          && canUseCompanyFolder(wid, pid, companyId, request.resource.data.get('folderId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow update: if (
          canWriteCompanyResourceInto(
            wid, pid, companyId,
            request.resource.data.get('folderId', ''),
            resource.data,
            request.resource.data
          )
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        ) && !projectFrozen(pid);
        allow delete: if (
          canModifyCompanyResource(wid, pid, companyId, resource.data)
        ) && !projectFrozen(pid);
      }

      // Sdílené firemní markupy jednoho planVersion. Task piny sem nepatří a
      // zůstávají v betě zakázané; dokument obsahuje pouze geometrické anotace.
      // Pozn.: rules neumí iterovat prvky listu, takže per-item typ nevaliduje —
      // task piny jsou v appce samostatné Tasky (ne anotace), FE je do `items`
      // nikdy nezapisuje a nad firemním plánem je i vytvoření pinu vypnuté.
      // Zde vynucujeme aspoň strop velikosti pole proti zneužití zápisem.
      match /planAnnotationSets/{versionId} {
        allow get: if hasCompanyResourceAccess(wid, pid, companyId, resource.data);
        allow list: if isCompanySpaceLead(wid, pid, companyId);
        allow create: if (
          isSameProjectCompany(wid, pid, companyId)
          && validCompanyResourceIdentity(companyId, request.resource.data)
          && request.resource.data.get('planVersionId', '') == versionId
          && request.resource.data.get('items', []) is list
          && request.resource.data.get('items', []).size() <= 2000
          && canUseCompanyPlan(wid, pid, companyId, request.resource.data.get('planId', ''), request.resource.data)
        ) && !projectFrozen(pid);
        allow update: if (
          canWriteCompanyAnnotationsInto(
            wid, pid, companyId,
            request.resource.data.get('planId', ''),
            resource.data,
            request.resource.data
          )
          && request.resource.data.get('scope', '') == resource.data.get('scope', '')
          && request.resource.data.get('ownerCompanyId', '') == resource.data.get('ownerCompanyId', '')
          && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
          && request.resource.data.get('planId', '') == resource.data.get('planId', '')
          && request.resource.data.get('planVersionId', '') == resource.data.get('planVersionId', '')
          && request.resource.data.get('items', []) is list
          && request.resource.data.get('items', []).size() <= 2000
        ) && !projectFrozen(pid);
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Notification queue (recipient-scoped reads)
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/projects/{pid}/notificationQueue/{notificationId} {
      allow create: if (
          isProjectMember(wid, pid)
        && request.resource.data.workspaceId == wid
        && request.resource.data.projectId == pid
        && request.resource.data.recipientIds is list
        ) && !projectFrozen(pid);
      // Provable for queries shaped
      // where('recipientIds', 'array-contains', currentPrincipal).
      //
      // 🔴 Nález D (#535): brána se ptala VÝHRADNĚ na `recipientIds`, bez
      // jediného slova o členství. Odebraný člověk si tedy své staré
      // notifikace četl dál — a ty nesou názvy úkolů a dokumentů i jména lidí.
      // Notifikace je obsah stavby; končí s členstvím, ne s adresou.
      allow get, list: if isProjectMember(wid, pid)
        && principal() in resource.data.recipientIds;
      // Recipients may only append themselves to readBy.
      allow update: if (
          isProjectMember(wid, pid)
        && principal() in resource.data.recipientIds
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readBy'])
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && principal() in request.resource.data.readBy
        ) && !projectFrozen(pid);
      allow delete: if (
          canManage(wid, pid)
        ) && !projectFrozen(pid);
    }

    // ---------------------------------------------------------------------
    // SCHRÁNKA POZORNOSTI (docs/ai/us-signal-druha-firma.md)
    //
    // „Ve firmě X na tebe čekají 2 věci." Signál, který člověka patřícího do
    // více firem dotáhne do prostoru té druhé. NENÍ to notifikace a nenese
    // ŽÁDNÝ TEXT — jen druh, stavbu a id předmětu.
    //
    // PROČ NA ÚROVNI FIRMY, ne stavby: jediný dotaz na firmu místo jednoho na
    // KAŽDOU stavbu. Egress je 63 % účtu; signál, který při každém načtení Hubu
    // přečte N staveb napříč firmami, je drahý napořád. Tady cena neroste
    // s počtem staveb ani s historií — vyřešená položka se MAŽE.
    //
    // 🔑 ČTECÍ BRÁNA SE NEPTÁ DOKUMENTU. Stojí výhradně na proměnných z cesty
    // (`inboxPrincipal`, `wid`), takže `list` je průkazný bez ohledu na tvar
    // dotazu a celá třída vad z #537 (`resource.data.get(pole, výchozí)`
    // selhávající OTEVŘENĚ ve výpisu) tu nemá kam se vejít.
    //
    // 🔴 Nález D (#539) obdobně: `isFirmParticipant` = signál končí s ČLENSTVÍM
    // ve firmě, ne s adresou. Kdo je z firmy odebrán (adresářový záznam smaže
    // vlastník/admin firmy), přestane schránku vidět. Mezistav „už nejsem na
    // stavbě, ale jsem ve firmě" nic neprozradí, protože v položce není text.
    // ---------------------------------------------------------------------

    function attentionKindOk(kind) {
      return kind == 'task.assigned'
        || kind == 'task.mentioned'
        || kind == 'approval.pending';
    }

    // Zapisovatel musí být členem TÉ STAVBY, kterou položka deklaruje — o
    // projektu tedy lhát nejde (deklarace a předmět jsou totéž pole; stejný vzor
    // jako `viaProjectId` u firemního adresáře). Že je členem i ADRESÁT ověřit
    // nejde bez dalšího čtení cizího členství; důsledek je nejhorší takový, že
    // člen firmy vyrobí odznak na stavbu, kterou adresát neotevře (UI ji zahodí).
    // Novou třídu zneužití to nezavádí — `notificationQueue` už dnes dovolí
    // členovi stavby zapsat notifikaci s libovolnými `recipientIds`, a to i s textem.
    function attentionWriteOk(wid) {
      return isProjectMember(wid, request.resource.data.get('projectId', ''))
        && request.resource.data.keys().hasOnly(['kind', 'projectId', 'refId', 'createdAt'])
        && attentionKindOk(request.resource.data.get('kind', ''))
        && request.resource.data.get('refId', '') is string
        && request.resource.data.get('refId', '') != ''
        && request.resource.data.get('createdAt', '') is string;
    }

    match /workspaces/{wid}/inbox/{inboxPrincipal}/items/{itemId} {
      allow get, list: if isRealUser()
        && principal() == inboxPrincipal
        && isFirmParticipant(wid);
      allow create: if attentionWriteOk(wid);
      // Id položky je deterministické (`kind:projectId:refId`), aby opakovaná
      // událost nad tou samou věcí schránku nenafoukla. Přepis proto musí projít
      // — ale smí obnovit jen `createdAt`, identita položky je immutable.
      allow update: if attentionWriteOk(wid)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.refId == resource.data.refId;
      // Vyřešit smí JEN adresát (a vlastník/admin firmy při úklidu). Pustit sem
      // kteréhokoli člena stavby by insiderovi dovolilo tiše zhasnout signál
      // o práci, která na někoho čeká. Falešně svítící odznak je nepříjemnost,
      // zhasnutý odznak je ztracená práce.
      allow delete: if (isRealUser() && principal() == inboxPrincipal)
        || isWsAdmin(wid);
    }

    // ---------------------------------------------------------------------
    // Project content collections (explicit enumeration -- no catch-all so
    // members/notificationQueue/invites can never be reached through these).
    // ---------------------------------------------------------------------

    // Task status-transition guard (issue #367, docs/TASK_WORKFLOW_USER_STORIES).
    // 'completed' = `edit` nebo autor (OQ-4); 'verified' = `certify` (OQ-5);
    // vrátit verified = `edit` (OQ-6a). Enforcuje se JEN na změně statusu;
    // nezměněný status projde komukoli, kdo smí obsah upravit (editace jiných
    // polí u hotového úkolu se nerozbije).
    function canCompleteTask(perms) {
      return perms.hasAny(['edit']);
    }
    // Autor úkolu (createdBy == principal). Funguje pro create i update — createdBy
    // je u update immutable, takže request.resource nese autora v obou případech.
    function taskAuthoredBySelf() {
      return request.resource.data.get('createdBy', '') == principal();
    }
    // Kdo smí dostat úkol DO „hotovo" stavu (issue #367, viz TASK_WORKFLOW_USER_STORIES):
    //  - 'verified'  = `certify` — OQ-5
    //  - 'completed' = `edit` NEBO autor vlastního úkolu — OQ-4
    function canReachDoneStatus(perms, status) {
      return status == 'verified' ? perms.hasAny(['certify'])
        : status == 'completed' ? (canCompleteTask(perms) || taskAuthoredBySelf())
        : true;
    }
    // Návrat ZPĚT z „hotovo" stavu (reopen). Dopředný postup completed→verified NENÍ
    // reopen (řeší ho jen canReachDoneStatus = `certify`), proto se sem nepočítá.
    //  - z 'verified'  = Koordinátor+ (vrací nalezenou vadu; nemusí být admin) — OQ-6a
    //  - z 'completed' do práce = Koordinátor+ NEBO autor — OQ-6c
    function reopenOk(perms, oldStatus, newStatus) {
      return oldStatus == 'verified' ? canCompleteTask(perms)
        : (oldStatus == 'completed' && newStatus != 'verified')
            ? (canCompleteTask(perms) || taskAuthoredBySelf())
        : true;
    }
    // Přechod je OK, když se status NEMĚNÍ, nebo když volající smí CÍLOVÝ dosáhnout
    // A (jde-li o návrat z hotovo) smí i reopen. verified nastaví Schvalovatel,
    // vrací Koordinátor+.
    function taskStatusTransitionOk(perms) {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
        || (canReachDoneStatus(perms, request.resource.data.get('status', ''))
            && reopenOk(perms, resource.data.get('status', ''), request.resource.data.get('status', '')));
    }

    // ── #358 Interní úkoly firmy (scope = company_internal) ──────────────────
    // Interní úkol vidí a řídí JEN členové vlastnící firmy (memberCompany ==
    // ownerCompanyId), napříč celým projektem — i mimo firmu (projektový admin,
    // wsAdmin) ho nevidí. Kdokoli z firmy smí na 'completed'; na 'verified' jen
    // vedoucí firmy. scope i ownerCompanyId jsou po vzniku neměnné.
    function taskIsInternal(data) {
      return data.get('scope', 'project_official') == 'company_internal';
    }
    // Volající je členem firmy vlastnící daný interní úkol (dle ownerCompanyId).
    function taskCompanyMember(pid, data) {
      return data.get('ownerCompanyId', '') != ''
        && memberCompany(pid, principal()) == data.get('ownerCompanyId', '');
    }
    // Identita interního úkolu při vzniku: vlastní firma, bez spoofingu.
    function validInternalTaskCreate(pid) {
      return request.resource.data.get('ownerCompanyId', '') != ''
        && request.resource.data.get('ownerCompanyId', '') == memberCompany(pid, principal());
    }
    // Denormalizovaná viditelnost úkolu (nález A1). MUSÍ odpovídat rozsahu:
    // interní úkol nese `visibility == ownerCompanyId`, projektový prázdný
    // řetězec. Bez toho by si zakladatel interního úkolu mohl zapsat
    // `visibility: ''` a vystavit ho výpisem celé stavbě.
    function taskVisibilityOk() {
      return taskIsInternal(request.resource.data)
        ? request.resource.data.get('visibility', '')
            == request.resource.data.get('ownerCompanyId', '')
        : request.resource.data.get('visibility', '') == '';
    }
    // scope i ownerCompanyId jsou po vzniku neměnné — rozsah nelze „přepnout".
    function taskScopeImmutable() {
      return request.resource.data.get('scope', 'project_official')
               == resource.data.get('scope', 'project_official')
        && request.resource.data.get('ownerCompanyId', '')
               == resource.data.get('ownerCompanyId', '');
    }
    // Interní úkol: na 'verified' jen vedoucí firmy; ostatní stavy kdokoli z firmy.
    function internalTaskStatusOk(wid, pid) {
      return request.resource.data.get('status', '') == resource.data.get('status', '')
        || (request.resource.data.get('status', '') == 'verified'
            ? isCompanySpaceLead(wid, pid, resource.data.get('ownerCompanyId', ''))
            : true);
    }

    // 🔑 JÁDRO #506: ověření úkolu je VLASTNÍ PŘECHOD, ne update cizího obsahu.
    //
    // Dosud update úkolu vyžadoval `canModifyContent`, takže schvalovatel bez
    // editačních práv (TDI, projektant) nemohl posunout do `verified` NIC, co
    // sám nenapsal — přestože `canReachDoneStatus` mu to výslovně dovolovalo.
    // Kontrolní role tedy nemohla provést kontrolní úkon.
    //
    // Tahle větev je úzká schválně: JEN přechod do `verified` a JEN pole, která
    // u toho zapisuje klient (`serializeTask` → status + razítko). Obsah úkolu
    // (název, popis, řešitel, přílohy) zůstává schvalovateli zapovězený —
    // `certify` je právo stvrdit, ne právo přepsat.
    function certifyTaskVerification(perms) {
      return perms.hasAny(['certify'])
        && request.resource.data.get('status', '') == 'verified'
        && resource.data.get('status', '') != 'verified'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedByUserId', 'activityLog']);
    }

    // Nový úkol nesmí rovnou vzniknout jako completed/verified bez příslušného
    // oprávnění (jinak by šel guard na update obejít vytvořením už-hotového
    // úkolu). Interní úkol: člen zakládá do své firmy a nesmí vzniknout rovnou
    // jako 'verified'.
    function taskCreateOk(perms, pid) {
      return canCreateWith(perms) && taskVisibilityOk() && (
        taskIsInternal(request.resource.data)
          ? (validInternalTaskCreate(pid)
             && request.resource.data.get('status', '') != 'verified')
          : canReachDoneStatus(perms, request.resource.data.get('status', ''))
      );
    }

    // Update PROJEKTOVÉHO úkolu: buď běžná práva k obsahu se stavovým guardem,
    // nebo úzká větev pro schvalovatele bez `edit` (ověření cizího úkolu).
    function taskProjectUpdateOk(perms) {
      return (canModifyWith(perms) && taskStatusTransitionOk(perms))
        || certifyTaskVerification(perms);
    }

    function taskPath(wid, pid, taskId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/tasks/$(taskId);
    }

    // Fotky/piny mohou referencovat úkol (taskId / context.taskId). Pokud ten
    // úkol je interní (scope=company_internal), nesmí referenci prozradit
    // (existenci + evidence photo URL) nikomu mimo vlastnící firmu — jinak by
    // photos/photoPins gate obcházel tasks gate výše. Bez taskId, s taskId na
    // neexistující/smazaný dokument, nebo na projektový (ne-interní) úkol se
    // chování nemění (čte kterýkoli člen projektu). exists()/get() na stejnou
    // cestu se v rámci jednoho requestu cachují (max +1 čtení navíc).
    function taskLinkReadOk(wid, pid, taskId) {
      return taskId == ''
        || !exists(taskPath(wid, pid, taskId))
        || !taskIsInternal(get(taskPath(wid, pid, taskId)).data)
        || taskCompanyMember(pid, get(taskPath(wid, pid, taskId)).data);
    }

    match /workspaces/{wid}/projects/{pid}/tasks/{docId} {
      // Interní úkol (scope=company_internal) čte jen člen vlastnící firmy;
      // projektový úkol kterýkoli člen projektu.
      allow get: if isProjectMember(wid, pid)
        && (!taskIsInternal(resource.data) || taskCompanyMember(pid, resource.data));
      // 🔴 Nález A1: `read` (tedy i `list`) tu stálo na `data.get('scope', …)`
      // s výchozí hodnotou, která ve výpisu VŽDY vyjde `project_official` —
      // interní úkoly firmy tak vypsal kterýkoli člen stavby, i z jiné firmy.
      // Výpis proto stojí na PŘÍMÉM `resource.data.visibility` (viz hlavička).
      allow list: if isProjectMember(wid, pid) && visibleInList(pid);
      // Nový úkol nesmí rovnou vzniknout jako completed/verified bez příslušné role
      // (jinak by šel guard na update obejít vytvořením už-hotového úkolu).
      // Interní úkol: člen zakládá do své firmy a nesmí vzniknout rovnou jako 'verified'.
      allow create: if taskCreateOk(permsOf(wid, pid), pid) && !projectFrozen(pid);
      // createdBy, scope i ownerCompanyId immutable. Interní úkol upraví člen
      // vlastnící firmy (na 'verified' jen vedoucí); projektový dle stávajících pravidel.
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && taskScopeImmutable()
        && taskVisibilityOk()
        && (
          taskIsInternal(resource.data)
            ? (taskCompanyMember(pid, resource.data) && internalTaskStatusOk(wid, pid))
            : taskProjectUpdateOk(permsOf(wid, pid))
        )
        // Zmrazení předáním platí i pro interní úkoly firmy — kopie je kopie.
        && !projectFrozen(pid);
      // Interní úkol smaže vedoucí firmy nebo autor (z vlastní firmy); projektový dle stávajících.
      allow delete: if (taskIsInternal(resource.data)
        ? (taskCompanyMember(pid, resource.data)
           && (isCompanySpaceLead(wid, pid, resource.data.get('ownerCompanyId', '')) || authoredBySelf()))
        : canModifyContent(wid, pid))
        && !projectFrozen(pid);
    }

    match /workspaces/{wid}/projects/{pid}/files/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // Denormalizovaná viditelnost fotky/pinu (nález A1). Vazba na úkol se
    // z výpisu dokázat NEDÁ — brána by musela sáhnout na CIZÍ dokument, a to
    // symbolické vyhodnocení neumí. Rozhodující údaj proto leží na fotce samotné
    // a při zápisu se ověřuje proti úkolu, na který se váže: nedá se vymyslet.
    function linkedVisibilityOk(wid, pid, taskId) {
      return (taskId == ''
              || !exists(taskPath(wid, pid, taskId))
              || !taskIsInternal(get(taskPath(wid, pid, taskId)).data))
        ? request.resource.data.get('visibility', '') == ''
        : request.resource.data.get('visibility', '')
            == get(taskPath(wid, pid, taskId)).data.get('ownerCompanyId', '');
    }

    match /workspaces/{wid}/projects/{pid}/photos/{docId} {
      // #358 leak fix: fotka navázaná na interní úkol (Photo.taskId) je čitelná
      // jen členům firmy vlastnící ten úkol — jinak by prozradila jeho existenci
      // a evidence URL mimo tasks gate výše.
      allow get: if isProjectMember(wid, pid)
        && taskLinkReadOk(wid, pid, resource.data.get('taskId', ''));
      // 🔴 Nález A1: ve výpisu `resource.data.get('taskId','')` vyšlo prázdné,
      // takže `taskLinkReadOk` propustilo i evidenční fotky interních úkolů
      // včetně URL. Výpis proto jede přes `visibility` (viz hlavička souboru).
      allow list: if isProjectMember(wid, pid) && visibleInList(pid);
      allow create: if canCreateContent(wid, pid)
        && linkedVisibilityOk(wid, pid, request.resource.data.get('taskId', ''));
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')  // author immutable
        && linkedVisibilityOk(wid, pid, request.resource.data.get('taskId', ''));
      allow delete: if canModifyContent(wid, pid);
    }

    // Připnutí fotky do kontextu (task/plán) + anotace té varianty. Fotka samotná
    // zůstává jeden záznam v /photos; pin ji jen referencuje (photoId).
    match /workspaces/{wid}/projects/{pid}/photoPins/{docId} {
      // #358 leak fix: stejná gate jako u /photos, jen taskId čteme z
      // PhotoPin.context.taskId (vnořené pole).
      allow get: if isProjectMember(wid, pid)
        && taskLinkReadOk(wid, pid, resource.data.get('context', {}).get('taskId', ''));
      allow list: if isProjectMember(wid, pid) && visibleInList(pid);
      allow create: if canCreateContent(wid, pid)
        && linkedVisibilityOk(wid, pid, request.resource.data.get('context', {}).get('taskId', ''));
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')  // author immutable
        && linkedVisibilityOk(wid, pid, request.resource.data.get('context', {}).get('taskId', ''));
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/diaryEntries/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // ---------------------------------------------------------------------
    // HLASOVKY DENNÍHO ZÁPISU (docs/ai/denni-zapis-hlasem.md).
    //
    // Syrový přepis toho, co člověk nadiktoval — VLASTNÍ kolekce, ne pole
    // deníkového zápisu. Do deníku jde věcný zápis v jazyce projektu; doslovná
    // slova mluvčího zůstávají tady a jinam se nekopírují (§9).
    //
    // 🔴 ČTE JEN AUTOR. Ani stavbyvedoucí, ani vlastník firmy, ani správce
    // stavby. Není to detail nastavení soukromí, je to nosná konstrukce celé
    // funkce (§1, §9): hlasovka má být ŠTÍT MLUVČÍHO, ne oko firmy. Jakmile si
    // vedení může přečíst, jak kdo o své práci mluví, lidi do týdne přejdou na
    // alibistické formality („pracovalo se dle harmonogramu") — a tím se
    // hodnota dat vynuluje i pro tu firmu. Doslovnost plodí autocenzuru;
    // přestane se říkat to důležité, tedy problémy.
    //
    // Vzor `get`/`list` je stejný jako u soukromého markupu (`planAnnotations`)
    // a ze stejného důvodu: ve výpisu vyjde `data.get('ownerPrincipal', '')`
    // prázdné, takže by cizí přepisy vydal obyčejný dotaz. Přímý přístup
    // k poli tenhle tvar odmítne a vynutí dotaz filtrovaný na vlastní záznamy.
    //
    // ZAKLÁDAT smí jen `edit`+ (fáze 1 cílí na management — stavbyvedoucí
    // a mistr, tedy ty role, které deník vést musí ze zákona; § 166 odst. 2
    // zák. 283/2021 Sb. vyjmenovává zapisovatele taxativně). Až se funkce
    // otevře řemeslníkům, bude to znamenat i per-projektový seznam osob
    // oprávněných zapisovat — a teprve tehdy se tenhle práh smí povolit.
    //
    // ⚠️ ZVUK SEM NEPATŘÍ a nikam jinam taky ne. Nahrávka nese identitu,
    // přízvuk, emoci a hlasy třetích osob v pozadí, kterým nikdo nic neřekl.
    // Ukládá se výhradně přepis (§10).
    // ---------------------------------------------------------------------
    match /workspaces/{wid}/projects/{pid}/dailyVoiceNotes/{docId} {
      allow get: if isProjectMember(wid, pid)
        && resource.data.get('ownerPrincipal', '') == principal();
      allow list: if isProjectMember(wid, pid)
        && resource.data.ownerPrincipal == principal();
      allow create: if (
          canEdit(wid, pid)
        && request.resource.data.get('ownerPrincipal', '') == principal()
        ) && !projectFrozen(pid);
      // Okno na opravu (§9) — do konce dne smí autor svůj zápis upravit nebo
      // smazat. Autorství je přitom neměnné: kdo hlasovku pořídil, ten u ní
      // zůstane, jinak by šlo cizí slova podepsat sebou (nebo svá někým jiným).
      allow update: if (
          isProjectMember(wid, pid)
        && resource.data.get('ownerPrincipal', '') == principal()
        && request.resource.data.get('ownerPrincipal', '') == resource.data.get('ownerPrincipal', '')
        ) && !projectFrozen(pid);
      allow delete: if (
          isProjectMember(wid, pid)
        && resource.data.get('ownerPrincipal', '') == principal()
        ) && !projectFrozen(pid);
    }

    // Plány: číst smí každý člen (`read`), měnit jen `edit`. Do #506 fáze 2
    // NEMĚL modul Plány na klientu ŽÁDNOU bránu — čtenář dostal celý toolbar
    // včetně markupu a kalibrace měřítka, zápis mu pravidla odmítla a appka ho
    // schovala do localStorage (nálezy U1–U3, F4). Klientská brána je teď
    // v `PlansPage`/`PlanViewer` a zrcadlí přesně tahle dvě práva.
    match /workspaces/{wid}/projects/{pid}/plans/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    match /workspaces/{wid}/projects/{pid}/planAnnotations/{docId} {
      // Soukromý markup (isPrivate) vidí JEN jeho autor (ownerPrincipal == principal);
      // veřejné vidí každý člen. Klient čte dvěma dotazy (veřejné + vlastní soukromé).
      allow get: if isProjectMember(wid, pid)
        && (resource.data.get('isPrivate', false) == false
            || resource.data.get('ownerPrincipal', '') == principal());
      // 🔴 Nález A1: ve výpisu `data.get('isPrivate', false)` vyšlo `false`,
      // takže cizí soukromý markup vydal obyčejný dotaz na `planVersionId` —
      // přesně ten, který posílá appka. Přímý přístup tenhle tvar odmítne
      // a vynutí dvojici dotazů (veřejné + vlastní), kterou klient stejně umí.
      allow list: if isProjectMember(wid, pid)
        && (resource.data.isPrivate == false
            || resource.data.ownerPrincipal == principal());
      allow create, update, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    match /workspaces/{wid}/projects/{pid}/documents/{docId} {
      allow read: if isProjectMember(wid, pid);
      // Do OFICIÁLNÍ dokumentace smí zakládat jen `publish`, ne každý člen.
      // Atribuce firmě jen na vlastní firmu (anti-spoof) a autor nesmí být podvržený.
      allow create: if officialCreateOk(permsOf(wid, pid), pid) && !projectFrozen(pid);
      // Author immutable. Editovat smí běžná práva k obsahu; `certify` nebo
      // `publish` navíc smí jako vedlejší efekt upload/approve transakce
      // přepnout jen platnou revizi (currentVersionId/updatedAt) — i když nemá
      // `edit` ani autorství (schválení revize / nová revize od publikujícího).
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && documentUpdateOk(permsOf(wid, pid))
        && !projectFrozen(pid);
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentVersions/{docId} {
      allow read: if isProjectMember(wid, pid);
      // Nahrát verzi do oficiální dokumentace smí jen `publish` (viz documents).
      allow create: if officialCreateOk(permsOf(wid, pid), pid) && !projectFrozen(pid);
      // `certify` (schvalovatel) smí zapsat SVÉ ROZHODNUTÍ: `approvals` mapu,
      // odvozený status (i supersede předchozí verze) a razítko recenzenta.
      //
      // 🔴 Nález R5 (#506): dřív tahle větev NEMĚLA žádné omezení polí, takže
      // schvalovatel — třeba člen jinak bez práva na cizí obsah — směl u
      // libovolné verze přepsat `filePath`, `versionLabel` i `documentId`.
      // Schvalovací právo tak bylo MOCNĚJŠÍ než editorské, přestože ho smí
      // rozdat i projektový admin, který role měnit nesmí. Teď je uzavřené
      // `hasOnly` na pole rozhodnutí — přesně to, co zapisuje
      // `documentService.ts` (`updateVersionStatus` / `recordApprovalDecision`).
      //
      // Ostatní (uploader/editor/autor) smí běžné editace, ale NE přechod do
      // rozhodnutí (zákaz self-approve). Audit se v rules nevynucuje.
      allow update: if request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')  // author immutable
        && versionUpdateOk(permsOf(wid, pid))
        && !projectFrozen(pid);
      allow delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentComments/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update: if canModifyContent(wid, pid)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');  // author immutable
      allow delete: if canModifyContent(wid, pid);
    }

    // Registr složek projektu (Fáze 1, bez per-složkových práv). Člen smí číst
    // a zakládat složky; mazat/měnit editor/admin/autor (canModifyContent).
    match /workspaces/{wid}/projects/{pid}/folders/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create: if canCreateContent(wid, pid);
      allow update, delete: if canModifyContent(wid, pid);
    }

    match /workspaces/{wid}/projects/{pid}/transmittals/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    // Zapečený stav dokumentace na hranici fáze — immutable otisk sady verzí.
    // Číst smí člen; zakládat/mazat editor; UPDATE ZAKÁZÁN (obsah je neměnný).
    // Bez `allow update` → updaty spadají do default-deny = immutabilita
    // vynucená rules (stejný vzor jako share pointer, jen tady i list pro člena).
    match /workspaces/{wid}/projects/{pid}/documentBaselines/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    match /workspaces/{wid}/projects/{pid}/documentEvents/{docId} {
      allow read: if isProjectMember(wid, pid);
      allow create, update, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    // ---------------------------------------------------------------------
    // Share links (bearer token documents -- public read-out of a single item)
    //
    // The token (doc id) is the secret, so `get` is public: an unauthenticated
    // recipient holding the link reads exactly that one record (title + a
    // already-public file URL -- never sensitive metadata). Listing requires
    // membership (managing share links), and only editors+ may create/revoke.
    // ---------------------------------------------------------------------

    match /workspaces/{wid}/projects/{pid}/shareLinks/{token} {
      allow get: if true;
      allow list: if isProjectMember(wid, pid);
      allow create, update, delete: if (
          canEdit(wid, pid)
        ) && !projectFrozen(pid);
    }

    // ---------------------------------------------------------------------
    // Document status pointer (#371 — verifikace revize přes QR)
    //
    // Public pointer to a document's CURRENT version so the anonymous
    // verification page (/share/:wid/:token) can tell whether the scanned
    // revision is current or superseded. Carries ONLY harmless data
    // (currentVersionId + label) -- never titles, URLs or member info.
    // Zapisuje se best-effort při uploadu (`edit`/`publish`) i při schválení
    // (`certify`) — schvalovatel ani publisher nemusí mít `edit`, proto tu jsou
    // všechny tři větve. Bez `publish` končila QR verifikace čerstvě nahrané
    // revize „neutrálním stavem" (nález F2).
    // ---------------------------------------------------------------------

    function validDocumentStatus(data) {
      // Veřejně čitelný doc — schema guard: JEN neškodná pole, žádné volné klíče.
      return data.keys().hasOnly(['currentVersionId', 'currentVersionLabel', 'updatedAt'])
        && data.currentVersionId is string && data.currentVersionId.size() > 0
        && data.currentVersionLabel is string;
    }

    match /workspaces/{wid}/projects/{pid}/documentStatus/{documentId} {
      allow get: if true;
      allow list: if isProjectMember(wid, pid);
      allow create, update: if permsOf(wid, pid).hasAny(['edit', 'certify', 'publish'])
        && validDocumentStatus(request.resource.data)
        && !projectFrozen(pid);
      allow delete: if canEdit(wid, pid) && !projectFrozen(pid);
    }

    // ---------------------------------------------------------------------
    // Top-level projects (source of truth for membership)
    // ---------------------------------------------------------------------

    // Invite self-join on the project doc: only adds the caller to
    // memberIds/roles, with the role copied from the members doc created in
    // the same batch (which itself requires a valid invite claim).
    //
    // 🔴 Nález C (#535): `companies` bylo v `hasOnly` allowlistu BEZ JAKÉKOLI
    // podmínky — na rozdíl od `memberIds` (přesně +1 prvek, jen já) a `roles`
    // (jen můj klíč, hodnota ze zrcadla). `projects/{pid}.companies` přitom
    // není popisné pole: čte ho `memberCompany` → `isSameProjectCompany` →
    // firemní prostory (#361) i interní úkoly (#358). Kdo přijímal pozvánku,
    // přiřkl si tím libovolnou firmu na té stavbě — a mohl přitom PŘEPSAT
    // zařazení všech ostatních.
    //
    // Teď platí totéž co pro `roles`: smí se hnout JEN můj klíč a JEN na
    // hodnotu, kterou nese pozvánka (přes `companyId` na zrcadle člena, které
    // je na invite doc navázané o pár řádků výš). Bez firmy v pozvánce vyjde
    // obojí `''` a klíč se vůbec neobjeví.
    function selfJoinMirrorPath(pid) {
      return /databases/$(database)/documents/workspaces/$(resource.data.workspaceId)/projects/$(pid)/members/$(principal());
    }

    function inviteSelfJoin(pid) {
      return isRealUser()
        && !(principal() in resource.data.get('memberIds', []))
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'roles', 'updatedAt', 'companies'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.hasAll(resource.data.get('memberIds', []))
        && request.resource.data.memberIds.size()
            == resource.data.get('memberIds', []).size() + 1
        && principal() in request.resource.data.memberIds
        && request.resource.data.roles.diff(resource.data.get('roles', {}))
            .affectedKeys().hasOnly([principal()])
        && request.resource.data.get('companies', {})
            .diff(resource.data.get('companies', {}))
            .affectedKeys().hasOnly([principal()])
        && stringOrEmpty(request.resource.data.get('companies', {}).get(principal(), ''))
            == stringOrEmpty(getAfter(selfJoinMirrorPath(pid)).data.get('companyId', ''))
        && request.resource.data.roles[principal()]
            == getAfter(selfJoinMirrorPath(pid)).data.role;
    }

    // -------------------------------------------------------------------
    // Vlastník dat projektu (#506, osa 3) — `projects/{pid}.dataOwner`.
    //
    // Vlastníkem dat je ten, KDO PLATÍ. Dosud se odvozoval od zakladatele
    // prostoru (`workspaces/{wid}.ownerId`), což neuneslo scénář „projektant
    // založí projekt a později ho postoupí investorovi": postoupení by přepsalo
    // vlastníka VŠECH staveb v prostoru.
    //
    // ⚠️ Pole NEDÁVÁ žádné oprávnění a rules ho k autorizaci nepoužívají — kdo
    // co smí, řeší `roles` + flagy. Vynucuje se jedině to, KDO ho smí přepsat:
    // dosavadní vlastník, nebo vlastník firmy. Ani projektový, ani firemní
    // ADMIN to sám nesvede — jinak by si projekt „koupil" kdokoli, kdo ho
    // spravuje, a postoupení by přestalo něco znamenat.
    //
    // Chybí-li pole (všechny stavby z doby před fází 3), je odvozeným
    // vlastníkem zakladatel prostoru — proto ho smí poprvé nastavit on.
    function dataOwnerUnchanged() {
      return request.resource.data.get('dataOwner', {}) == resource.data.get('dataOwner', {});
    }

    function canTransferDataOwner() {
      return resource.data.get('dataOwner', {}).get('principal', '') == principal()
        || isWsOwner(resource.data.get('workspaceId', ''));
    }

    // -------------------------------------------------------------------
    // Přeřazení UŽ PŘIJATÉHO člena správcem stavby (#507).
    //
    // Do teď uměl roli změnit jedině vlastník/admin FIRMY (`isWsAdmin`).
    // Správce stavby zvenčí — generální dodavatel na investorově stavbě — tedy
    // směl zvát vlastní lidi i subdodavatele, ale nesměl nikomu přidat práva:
    // musel ho odebrat a pozvat znovu. Denní úkon, který se dělal oklikou.
    //
    // Rozšíření je ÚZKÉ a stojí vedle stávajících větví, žádnou nemění.
    // Držitel `manage` na projektu smí přesně jedno: změnit roli JEDNOHO
    // CIZÍHO člena na `reader` / `viewer` / `editor`. Nesmí:
    //   · povýšit kohokoli (ani sebe) na `admin` — jinak by byl allowlist
    //     `roleAssignable` i strop rolí v pozvánkách k ničemu a eskalace by
    //     vedla tudy,
    //   · sáhnout na SVOU roli (ani nahoru, ani dolů),
    //   · degradovat jiného `admin`a — dva správci na stavbě by si jinak mohli
    //     navzájem brát práva (přesně to hlídala poznámka u větve výš),
    //   · hnout `memberIds` (přidání/odebrání člena zůstává u firmy a pozvánek)
    //     ani `dataOwner` (ten přepíše jen dosavadní vlastník / vlastník firmy,
    //     #506 osa 3) — ani jedno není v `hasOnly` allowlistu.
    //
    // 🔑 Proč deklarované `roleChangeTarget`: rules NEUMÍ vytáhnout klíč ze
    // Setu, který vrací `diff().affectedKeys()`. Bez znalosti toho klíče nejde
    // přečíst starou ani novou hodnotu role, takže „nepovyšuj na admin" by se
    // nedalo vynutit VŮBEC. Zápis proto musí sám deklarovat, koho mění,
    // a pravidla tu deklaraci porovnají s tím, co se v mapě opravdu hnulo
    // (`hasOnly([target])`). Lhát se nedá: kdyby se změnil kdokoli jiný,
    // `hasOnly` neprojde. Deklarace stojí NULA dalších čtení dokumentů — a to
    // je tu ta vzácná surovina (`redeemOk` sám vytěžuje 7 z 10).
    //
    // Pole zůstane na dokumentu jako drobek do historie („poslední přeřazení
    // se týkalo tohohle člověka"). Žádné oprávnění z něj neplyne a nikdo ho
    // nečte — je to VSTUP pravidla, ne stav.
    //
    // ⚠️ Zrcadlo členů má vlastní branku `mirrorRoleChangeOk` se STEJNÝMI
    // podmínkami. Měň obojí naráz, jinak se cesty rozejdou.
    function roleChangeOk(target) {
      return target is string
        && target != ''
        && target != principal()
        && target in resource.data.get('memberIds', [])
        && resource.data.get('roles', {}).get(target, '') != 'admin'
        && request.resource.data.get('roles', {}).get(target, '') in ['reader', 'viewer', 'editor']
        && request.resource.data.get('roles', {})
            .diff(resource.data.get('roles', {}))
            .affectedKeys().hasOnly([target]);
    }

    // `manage` odvozené PŘÍMO z role na project docu, bez `permsOf()`. Jsme
    // uvnitř `/projects/{pid}`, kde `resource.data` už v ruce máme — `permsOf()`
    // by tu znamenalo tři čtení dokumentů navíc kvůli údaji, který leží přímo
    // před námi. Vlastník/admin firmy sem nespadá, ten má vlastní větev výš.
    function projectRoleHasManage() {
      return rolePermissions(resource.data.get('roles', {}).get(principal(), '')).hasAny(['manage']);
    }

    match /projects/{pid} {
      // Direct field access keeps the rule provable for both query shapes:
      // where('memberIds','array-contains', principal) and
      // where('workspaceId','==', wid) issued by workspace admins.
      allow get, list: if isRealUser()
        && (principal() in resource.data.memberIds
            || isWsAdmin(resource.data.workspaceId));
      allow create: if isRealUser()
        && isWsAdmin(request.resource.data.workspaceId)
        && principal() in request.resource.data.memberIds
        && request.resource.data.roles.get(principal(), '') == 'admin'
        // Zakladatel smí projekt založit jako VLASTNÍ (typicky projektant
        // v přípravě), ne rovnou cizí. Postoupení je samostatný úkon.
        && request.resource.data.get('dataOwner', {}).get('principal', principal()) == principal()
        // 🔴 Serverová pole nesmí jít zapsat ANI PŘI VZNIKU dokumentu.
        // Do 8/2026 tu denylist chyběl úplně, zatímco obě větve `update` níž
        // ta samá pole zakazují — a zakládající admin firmy si tak jedním
        // `set()` zapsal to, co mu druhý den `update` odepře. Nejde o únik
        // mezi firmami (stavba je vlastní), jde o to, že jinak chráněné pole
        // má druhou, neuhlídanou cestu dovnitř — přesně ta třída chyby, před
        // kterou tenhle soubor na jiných místech varuje.
        //
        // Seznam je ZÁMĚRNĚ týž jako v denylistu admina firmy níž, protože
        // zakladatel JE admin firmy; kdo sem přidá pole tam, musí ho přidat
        // i sem. Konkrétně:
        //  - `handover`: `{ state: 'moving', frozenUntil: <daleko> }` zapsané
        //    při zakládání zamkne stavbu natrvalo jen ke čtení a z klienta to
        //    nejde vrátit — pole už měnit nesmí nikdo, takže by na rozmrazení
        //    bylo potřeba Admin SDK. Píše ho výhradně `acceptProjectHandover`.
        //  - `observation`: testovací provoz je plnění smlouvy, zapíná ho
        //    provozovatel z `/provoz`. Založit stavbu rovnou „ve sběru dat" je
        //    tentýž obchvat jako zapnout si ho potom.
        //  - `lastActivityAt`: fakturační veličina vázaná na `request.time`.
        //    Bez tohohle si jde stavba založit s ročním datem v minulosti,
        //    tedy rovnou jako „spící".
        //
        // `keys()` (ne `diff()`): při create žádné `resource` neexistuje.
        && !request.resource.data.keys()
            .hasAny(['handover', 'observation', 'lastActivityAt']);
      // Workspace owner/admin: full project doc control incl. membership.
      // Project admin: may edit project content but MUST NOT touch
      // memberIds/dataOwner (kdo je členem se mění jen přes wsAdmin nebo
      // pozvánku). Na `roles` sáhne jen úzkou větví #507 níž — přeřazení
      // JEDNOHO cizího ne-admin člena na ne-admin roli; degradovat jiného
      // admina ani sebe povýšit tou cestou nejde.
      allow update: if (
          isRealUser()
          && isWsAdmin(resource.data.get('workspaceId', ''))
          && request.resource.data.workspaceId == resource.data.workspaceId
          // Vlastnictví dat je výjimka z „ws admin smí všechno": postoupit ho
          // smí jen dosavadní vlastník nebo vlastník firmy (viz komentář výš).
          && (dataOwnerUnchanged() || canTransferDataOwner())
          // 🔴 Druhá výjimka: značku aktivity si nevybírá NIKDO, ani admin firmy.
          // Bez tohohle by vazba na `request.time` v dedikované větvi níž byla
          // dekorace — kdo smí do project docu psát cokoli, obejde ji tím, že
          // `lastActivityAt` zapíše touhle širší cestou. Legitimní zápis jde
          // dedikovanou větví (`hasOnly` + `== request.time`), která adminy
          // firmy pouští taky.
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['lastActivityAt',
                       // 🔴 Stav předání stavby píše VÝHRADNĚ server
                       // (`acceptProjectHandover`). Z pole plyne peněžní
                       // závazek nového vlastníka a po dobu kopie i zmrazení
                       // zápisů — kdyby na něj dosáhl admin firmy, uměl by si
                       // stavbu „předat" bez druhé strany i shodit zmrazení
                       // uprostřed kopírování. Viz
                       // docs/ai/predani-stavby-a-placeni.md.
                       'handover',
                       // 🔴 Testovací provoz zapíná VÝHRADNĚ provozovatel
                       // z konzole `/provoz` (Admin SDK), po dohodě se
                       // zákazníkem — v aplikaci pro něj žádný ovladač není
                       // a nesmí být. Kdyby si ho admin firmy zapnul sám,
                       // sbírali bychom data z domluvy, která neproběhla,
                       // a lidem na stavbě bychom ukázali dotaz na něco,
                       // o čem provozovatel neví. Viz
                       // docs/legal/PRILOHA_TESTOVACI_PROVOZ.md §3.
                       'observation'])
        ) || (
          // Postoupení vlastnictví DOSAVADNÍM vlastníkem — i když projekt vůbec
          // nespravuje. Přesně to je scénář „projektant založí projekt v přípravě
          // a později ho postoupí investorovi": projektant je na stavbě běžný
          // koordinátor, ale data jsou jeho, dokud je nepředá.
          //
          // `hasOnly` (ne `!hasAny`): touhle větví se smí měnit VÝHRADNĚ
          // vlastnictví. Kdyby to byl denylist, měl by vlastník bez `manage`
          // najednou plný zápis do project docu.
          isRealUser()
          && resource.data.get('dataOwner', {}).get('principal', '') == principal()
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['dataOwner', 'updatedAt'])
        ) || (
          // 🔴 Nález C2 (#535): `companies` v tomhle denylistu CHYBĚLO, takže si
          // správce stavby kdykoli přiřkl libovolnou firmu — a otevřel si tím
          // její interní prostor i interní úkoly, které #358 výslovně skrývá
          // i před ním. Přiřazení k firmě je úkon vlastníka/admina FIRMY
          // (`setProjectMemberCompany`), ne správce stavby.
          //
          // 🔴 `archived` přibylo do denylistu ze STEJNÉHO důvodu, jen s cenou
          // v penězích: návrh VOP čl. 4.3 slibuje „archivovaná stavba se
          // nefakturuje", takže příznak přestal být provozní vlastností a stal
          // se ovladačem částky. Správce stavby přitom není smluvní strana —
          // tou je firma (`workspaces/{wid}.ownerId`, rozhodnutí R1 v
          // docs/ai/fakturace-rozhodnuti.md). Archivace je proto úkon
          // vlastníka/admina FIRMY; ti mají vlastní větev výš.
          //
          // ⚠️ Tohle NENÍ dostatečný podklad k fakturaci. Zúžení bere lateralní
          // plochu (kterýkoli z N správců staveb), ne motiv — vlastník firmy je
          // právě ten, kdo by fakturu obcházel. Fakturační veličina proto
          // nesmí `archived` číst jako pravdu; počítá ji nezávislý měsíční
          // sweep (tamtéž, kap. 5, varianta b).
          isRealUser()
          && resource.data.get('roles', {}).get(principal(), '') == 'admin'
          && request.resource.data.workspaceId == resource.data.workspaceId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['memberIds', 'roles', 'dataOwner', 'companies', 'archived',
                       // Tentýž důvod jako u admina firmy výš — a tady o to
                       // silnější: správce stavby není ani smluvní strana.
                       'handover',
                       // Tentýž důvod jako u admina firmy o dvě větve výš:
                       // jinak by vazba značky na `request.time` platila jen pro
                       // ty, kdo do project docu jinak psát nesmí.
                       'lastActivityAt',
                       // 🔴 Testovací provoz je PLNĚNÍ SMLOUVY, ne provozní
                       // vlastnost stavby: firma za něj dostává službu zdarma
                       // a zavazuje se informovat své lidi
                       // (docs/legal/PRILOHA_TESTOVACI_PROVOZ.md §3). Smluvní
                       // strana je firma (`workspaces/{wid}.ownerId`), ne
                       // správce stavby — ten by jinak zapnul sběr dat na
                       // stavbě, o které se nikdo ze statutárů nedozví.
                       // Tatáž úvaha jako u `archived` o řádek výš.
                       'observation'])
        ) || (
          // Přeřazení JEDNOHO cizího člena správcem stavby (#507) — jediná
          // cesta, kterou se `roles` mění bez vlastníka/admina firmy.
          // Podmínky a důvody viz `roleChangeOk` výš.
          //
          // Uzavřené `hasOnly` (ne denylist): touhle větví smí projít VÝHRADNĚ
          // role + deklarace + časové razítko. `memberIds` ani `dataOwner`
          // v seznamu nejsou, takže se přes ni nedají hnout — a nedají se hnout
          // ani pole, která na project docu teprve přibudou.
          isRealUser()
          && projectRoleHasManage()
          && request.resource.data.workspaceId == resource.data.workspaceId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['roles', 'roleChangeTarget', 'updatedAt'])
          && roleChangeOk(request.resource.data.get('roleChangeTarget', ''))
        ) || (
          // Značka „stavba žije" — `lastActivityAt`
          // (docs/BILLING_IMPLEMENTATION.md kap. 2.2, návrh
          // docs/ai/blok-a-rules-navrh.md). Píše ji `src/services/projectActivity.ts`
          // po jakékoli práci na stavbě, takže ji musí umět zapsat i běžný
          // přispěvatel, který do project docu jinak psát nesmí. Bez téhle
          // větve se značka zapisuje jen tehdy, když je zrovna online správce —
          // tedy prakticky nikdy, a měření je k ničemu.
          //
          // Uzavřené `hasOnly` (ne `!hasAny([...])`): propustí PRÁVĚ jeden klíč,
          // takže se přes tuhle větev nedá sáhnout na memberIds/roles/
          // workspaceId/archived/modules — ani na pole, která na project docu
          // teprve přibudou. Allowlist přes `!hasAny` by naopak s každým novým
          // polem tiše otevíral díru.
          //
          // 🔴 Hodnotu určuje SERVER, ne klient. Do 8/2026 tu stálo jen
          // `is string` (ISO, kvůli shodě s `createdAt`/`updatedAt`) — jenže
          // řetězec pravidla neumí porovnat s `request.time`, takže si kterýkoli
          // člen zapsal značku rok starou a stavba přestala vypadat jako živá.
          // U provozního údaje by to bylo snesitelné; jakmile se ze „žije /
          // nežije" počítá částka, je to ovladač faktury (`archived` výš má
          // tentýž problém). Pole je proto TIMESTAMP a musí se rovnat
          // `request.time` — klient posílá `serverTimestamp()`
          // (`src/services/projectActivity.ts`), který se právě na `request.time`
          // vyhodnotí, a to i u offline zápisu, protože sentinel se rozhoduje
          // až při commitu na serveru.
          //
          // ⚠️ Migrace se NEDĚLÁ. Pravidlo omezuje jen NOVOU hodnotu; staré ISO
          // řetězce na existujících stavbách zůstanou a čtení je snese
          // (`asDate` v `src/services/workspaceProjects.ts` bere Date, string
          // i Timestamp). Admin cesty mimo rules (seed) píšou dál ISO záměrně —
          // seedovaná „spící" stavba potřebuje datum v minulosti, které tahle
          // větev z principu vytvořit nemůže.
          // Admin firmy sem patří taky: `isProjectMember` ho na stavbu pouští
          // i bez `memberIds`, takže fotku nahrát smí — a kdyby značku zapsat
          // nesměl, byl by to jediný způsob práce, po kterém stavba nevypadá
          // živá. Hodnotu si přitom nevybere ani on (viz jeho vlastní větev výš).
          isRealUser()
          && (principal() in resource.data.get('memberIds', [])
              || isWsAdmin(resource.data.get('workspaceId', '')))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastActivityAt'])
          && request.resource.data.lastActivityAt == request.time
        ) || inviteSelfJoin(pid);
      allow delete: if isRealUser()
        && (resource.data.get('roles', {}).get(principal(), '') == 'admin'
            || isWsAdmin(resource.data.get('workspaceId', '')));
    }

    // ---------------------------------------------------------------------
    // Počítadlo spotřeby stavby — `projects/{pid}/usage/{docId}`
    // (docs/BILLING_IMPLEMENTATION.md kap. 2.3, návrh docs/ai/blok-a-rules-navrh.md).
    //
    // Mění se VÝHRADNĚ přírůstkem (`FieldValue.increment`) při uploadu nebo
    // trvalém smazání — `src/services/projectUsage.ts`. Že jde opravdu
    // o increment, rules ověřit nedokážou; vynutitelné maximum je uzavřený
    // seznam klíčů (`hasOnly`), aby se do dokumentu nedaly propašovat cizí pole
    // (`plan`, `amount`, …), ze kterých by někdo mohl začít odvozovat cenu.
    //
    // 🔴 Zápis je klientský, tedy FALŠOVATELNÝ. Vědomě přijaté: tenhle blok
    // MĚŘÍ, nefakturuje. Z `usage` se NIKDY nesmí odvodit žádná částka.
    //
    // ⚠️ Dřív tu stálo, že se blok „až se bude fakturovat" přepne na
    // `allow write: if false` a bude ho psát Cloud Function. To je past a
    // rozhodnutí padlo opačně (docs/ai/fakturace-rozhodnuti.md, kap. 5,
    // varianta b): serverový zápis by sáhl do uploadové cesty, kde platí
    // nejtvrdší invariant celého modelu — NAFOCENÁ FOTKA SE KVŮLI MĚŘENÍ NIKDY
    // NEZAHODÍ. Počítadlo proto zůstává klientské a slouží tomu, čemu dnes:
    // proužku „80 % zaplněno" a návrhu archivace. Na to je falšovatelné číslo
    // dost dobré — kdo si ho podstřelí, ošidí sám sebe o varování.
    //
    // Fakturační veličina vzniká JINDE a nezávisle: měsíčním serverovým
    // sweepem nad skutečně vzniklým obsahem, se zápisem do
    // `workspaces/{wid}/billingSnapshots/{YYYY-MM}`. Kdo sem přijde napojit
    // fakturaci na `usage`, dělá chybu, kterou tenhle odstavec popisuje.
    //
    // Proč je bránou zápisu ČLENSTVÍ, a ne oprávnění `edit`: novou fotku smí
    // založit každý člen projektu VČETNĚ viewera — `photos` gatuje
    // `canCreateContent` a `storage.rules` výslovně pouští založení nového
    // objektu „každému členu projektu včetně viewera". S užší bránou by
    // viewerův upload počítadlo nezvedl a spotřeba by se tiše PODhodnotila —
    // přesně ta třída chyby, kvůli které tahle pravidla vznikla. Nikomu to
    // nedává nic navíc: kdo smí nahrávat obsah, ten číslem stejně hýbe.
    match /projects/{pid}/usage/{docId} {
      allow read: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      // POZOR: `create, update` — NIKDY `write`. `allow write` pokrývá i delete
      // a s `allow delete: if false` níž by se OR-oval (souběžné allow větve se
      // skládají SJEDNOCENÍM, ne průnikem), takže by zákaz mazání byl pouhá
      // dekorace a počítadlo by šlo vynulovat smazáním dokumentu. Ověřeno
      // v emulátoru: `allow write` + `allow delete: if false` mazání PUSTÍ.
      // (Že to dnes při doslovném `hasOnly` nespadne, je jen náhoda —
      // `request.resource` je u delete null, takže výraz skončí chybou. Na
      // takové náhodě se bezpečnost stavět nesmí.)
      allow create, update: if isProjectMember(projectData(pid).get('workspaceId', ''), pid)
        && request.resource.data.keys()
             .hasOnly(['storageBytes', 'photoCount', 'docCount', 'updatedAt'])
        && request.resource.data.get('storageBytes', 0) is number
        && request.resource.data.get('photoCount', 0) is number
        && request.resource.data.get('docCount', 0) is number;
      // Počítadlo se snižuje ZÁPORNÝM přírůstkem, ne mazáním dokumentu.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // FAKTURACE — první serverem psané dokumenty v tomhle repu
    //
    // Tři kolekce, které dohromady drží fakturační veličinu. Všechny mají
    // `allow write: if false` a píše je VÝHRADNĚ Cloud Function admin SDK,
    // který pravidla obchází. To je ta „jindy a nezávisle" cesta, kterou
    // popisuje odstavec nad blokem `usage`: z falšovatelného počítadla se
    // nikdy nesmí odvodit částka, takže si fakturace vede vlastní stopu.
    //
    // 🔴 PROČ `allow write: if false` A NIKDY `allow write: if <podmínka>`:
    // souběžné `allow` větve se skládají SJEDNOCENÍM. Kdyby tu bylo
    // `allow write: if <cokoli>` a vedle `allow delete: if false`, zákaz
    // mazání by byl dekorace — přesně past popsaná u `usage` výš.
    //
    // 🔴 ČTENÍ SE NIKDY NEPODMIŇUJE PLÁNEM. Tyhle bloky říkají, kdo smí vidět
    // fakturační údaje; NEŘÍKAJÍ nic o přístupu k obsahu stavby. Chyba
    // ve fakturačním dokumentu nesmí zamknout partii z výkresů — gatuje se
    // jen to, co tvoří náklad, nikdy ne opačně (VOP čl. 13.3: data na stavbě
    // jsou důkazní materiál).

    // Serverový marker aktivity stavby za kalendářní měsíc.
    //
    // Píše ho trigger `recordProjectActivity` při KAŽDÉM zápisu do obsahu
    // stavby; `writeCount` je proto zároveň naměřený objem činnosti pro
    // pásma (V2) a fair-use práh (V13). Aktivní stavba = marker za daný měsíc
    // existuje. Tohle je jediný signál aktivity, kterému fakturace věří —
    // `lastActivityAt` na project docu je klientský string bez vazby na
    // `request.time`, takže by si každý člen stavbu „uspal".
    //
    // Čtení pouští členům stavby záměrně: je to podklad toho, co jim přijde
    // na faktuře, a VOP zákazníkovi na výpis dává právo.
    match /workspaces/{wid}/projects/{pid}/activity/{month} {
      allow read: if isProjectMember(wid, pid);
      allow write: if false;
    }

    // Stav předplatného firmy. Jeden dokument (`current`).
    //
    // Čte jen VLASTNÍK A SPRÁVCI firmy — obrazovka Předplatné je podle
    // `docs/ai/cenik-upgrade-us.md` kap. C.1 pro ostatní členy a hosty
    // NEVIDITELNÁ (ne zakázaná — neviditelná). Širší čtení by nikomu nic
    // nedalo a rozšířilo by okruh lidí, kteří vidí fakturační stav firmy.
    match /workspaces/{wid}/billing/{docId} {
      allow read: if isWsAdmin(wid);
      allow write: if false;
    }

    // Měsíční snímek, ze kterého vznikla faktura. Append-only.
    //
    // Sweep existující snímek NIKDY nepřepíše — cena se nesmí měnit zpětně
    // (V3). Že je append-only, vynucuje `write: if false` plus logika sweepu;
    // pravidla to samy ověřit nedokážou, protože admin SDK jimi neprochází.
    match /workspaces/{wid}/billingSnapshots/{month} {
      allow read: if isWsAdmin(wid);
      allow write: if false;
    }

    // Neměnná auditní stopa projektu.
    //
    // 🟠 Nález F3 (#506): create dřív vyžadoval `canEditContent`, jenže úkol smí
    // legitimně posunout i přispěvatel (svůj vlastní) a nově SCHVALOVATEL
    // (`certify` → `verified` na cizím úkolu). Právě u nich audit dává největší
    // smysl, a právě jim zápis pravidla odmítla — takže „schvalovatel ověřil
    // úkol" se do stopy nikdy nezapsalo. Zápis je proto na úrovni ČLENSTVÍ:
    // záznam je stejně append-only (update i delete zůstávají zakázané), takže
    // širší brána nedovolí historii přepsat, jen doplnit.
    match /projects/{pid}/task_audit/{entryId} {
      allow read: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      allow create: if isProjectMember(projectData(pid).get('workspaceId', ''), pid);
      allow update, delete: if false;
    }

    // Legacy annotation blobs -- superseded by
    // workspaces/{wid}/projects/{pid}/planAnnotations.
    match /plan_annotations/{docId} {
      allow read, write: if false;
    }

    // User registry (workspace connections) — used when this project also
    // serves as the central/login project (single-project deployment).
    // Owner-only: each user reads/writes only their own registry doc.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // Pending invites registry (CENTRÁLNÍ projekt openbuildos)
    //
    // Mirror firemní pozvánky, aby ji pozvaný NAŠEL po přihlášení i bez linku
    // (firemní invite žije jen ve workspaces/{wid}/invites/{token}, kam nemá
    // přístup). Doc id = token = bearer tajemství (náhodný UUID).
    //
    // Čte JEN adresát (match jeho ověřeného e-mailu), publikuje libovolný reálný
    // uživatel (zvoucí admin firmy), status flipne JEN adresát. Pole nesou
    // veřejné klientské identifikátory firmy (apiKey ap.) pro sestavení
    // WorkspaceConnection při přijetí — nic tajného.
    // Query příjemce: where('inviteeEmail','==', mojeEmail) & where('status','==','pending').
    // ---------------------------------------------------------------------
    match /pendingInvites/{token} {
      // Adresát čte svoje pozvánky (i výpisem). Zvoucí smí přečíst JEN konkrétní
      // pozvánku, kterou sám založil (`get`, ne `list`) — potřebuje to relay
      // zvacích e-mailů, který dokument čte JMÉNEM přihlášeného uživatele, takže
      // oprávnění vynutí tahle rule. Rozšířit i `list` by dovolilo enumeraci
      // cizích pozvánek, proto výpis zůstává jen adresátovi.
      //
      // 🔴 Nález A1 (#535): obě větve stály na `.get(…, '')` NA OBOU STRANÁCH.
      // Ve výpisu vyšel `inviteeEmail` prázdný a token bez claimu `email` taky —
      // `'' == ''` → kdokoli přihlášený BEZ e-mailu si vypsal CELÝ registr:
      // tokeny, `apiKey`, `authExchangeUrl`, e-maily i názvy staveb napříč
      // všemi firmami. V hostovaném modelu únik přes hranici zákazníka.
      //
      // Token se proto čte PŘÍMO (`request.auth.token.email`): chybí-li claim,
      // výraz skončí chybou a požadavek se odmítne — nikdy se neporovnají dvě
      // prázdné hodnoty. `get` si předsadí ještě explicitní kontrolu, ať je
      // fail-closed čitelný i bez znalosti sémantiky chyb.
      allow get: if isRealUser()
        && request.auth.token.get('email', '') != ''
        && (resource.data.get('inviteeEmail', '') == request.auth.token.email
            || resource.data.get('inviterEmail', '') == request.auth.token.email);
      allow list: if isRealUser()
        && resource.data.inviteeEmail == request.auth.token.email;
      // POZOR (bezpečnost): tento create dovoluje LIBOVOLNÉMU reálnému uživateli
      // vytvořit pozvánku s libovolným authExchangeUrl/apiKey mířícím na cizí
      // backend. hasOnly níže zamezuje injektáži cizích polí a inviterEmail se
      // váže na skutečného odesílatele (nelze se vydávat za kolegu podle e-mailu),
      // ale JÁDRO rizika (klient si sám píše authExchangeUrl) tím vyřešené NENÍ —
      // ten musí ošetřit konzument tokenu na FE (re-derivace z config/public +
      // potvrzení cíle uživatelem), případně přesun zápisu do Cloud Function.
      allow create: if isRealUser()
        // POZOR: 'token' tu MUSÍ být. Klient ho zapisuje i do dat (nejen jako
        // doc id) — bez něj hasOnly zápis odmítne a pozvánka se do centrálního
        // registru vůbec nedostane. Přesně to se stalo po #396: publikace tiše
        // padala na permission-denied, takže adresát pozvánku nikdy neuviděl
        // v Hubu a nešlo ji ani odeslat e-mailem.
        && request.resource.data.diff({}).affectedKeys().hasOnly([
             'token', 'workspaceId', 'workspaceName', 'apiKey', 'authExchangeUrl',
             'projectId', 'projectName', 'role', 'inviteeEmail',
             'inviterName', 'inviterEmail', 'status', 'createdAt', 'expiresAt',
             // #506 fáze 3: popisná profese, aby adresát v Hubu viděl, KAM ho
             // zvou („jako TDI"), ne jen surovou roli. Oprávnění neurčuje.
             'profession'
           ])
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('inviteeEmail', '') is string
        && request.resource.data.get('inviteeEmail', '') != ''
        // 🔑 #549 nález A: Hub schovává „Přijmout" u PROŠLÉ pozvánky podle
        // `expiresAt`. Aby to nebyl „ovladač nad mechanismem, který nic nedělá"
        // (jako `usage` nebo `membershipKind`), musí být to pole průkazné —
        // jinak by si klient zapsal expiraci v roce 2099 a Hub by dál nabízel
        // akci, kterou firemní `redeemOk` (`request.time < expiresAt`) odmítne.
        //
        // Proto se `expiresAt` váže na SERVEROVÝ čas: nesmí být v minulosti (to
        // by byla mrtvá pozvánka) ani dál než TTL + den vůle. Den vůle je tam
        // schválně — hodnotu počítá klient ze SVÝCH hodin, a tvrdší okno by u
        // rozjetých hodin nechalo publikaci padat na permission-denied a
        // adresát by pozvánku v Hubu nikdy neuviděl (regrese po #396).
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(15, 'd')
        && request.resource.data.createdAt is timestamp
        // inviterEmail smí být buď prázdný/null (admin bez e-mailu), nebo se MUSÍ
        // shodovat s e-mailem odesílatele — nelze se vydávat za konkrétního kolegu.
        && (request.resource.data.get('inviterEmail', null) == null
            || request.resource.data.get('inviterEmail', '') == request.auth.token.get('email', ''))
        && request.resource.data.get('role', '') in ['reader', 'viewer', 'editor'];
      // Adresát smí jen překlopit status (přijmout/odmítnout), nic jiného.
      allow update: if isRealUser()
        && resource.data.get('inviteeEmail', '') == request.auth.token.get('email', '')
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // NÁVRH NA PŘEDÁNÍ STAVBY NOVÉMU VLASTNÍKOVI (F1)
    //
    // Předání = přesun stavby do prostoru nového vlastníka; návrh
    // v docs/ai/predani-stavby-a-placeni.md. Návrh musí přečíst někdo, kdo
    // v prostoru zdroje NENÍ ČLENEM — jinak by ho nemohl přijmout. Tentýž
    // problém řeší `pendingInvites`, proto tentýž vzor: adresa je e-mail
    // z tokenu, ne členství.
    //
    // 🔴 CELÝ DOKUMENT PÍŠE SERVER (`allow write: if false`) — na rozdíl od
    // `pendingInvites`, které klient zakládá sám. Z návrhu totiž plyne PENĚŽNÍ
    // ZÁVAZEK: kdo ho přijme, začne za stavbu platit. Klientský zápis by
    // znamenal, že si stav „přijato" nastaví kterákoli strana sama — a že si
    // navrhovatel vybere, komu závazek přiřkne, bez jeho souhlasu.
    //
    // 🔴 Nález A1 (#535) platí i tady: `request.auth.token.email` se čte PŘÍMO,
    // ne přes `.get(…, '')`. Kdyby se porovnávaly dvě prázdné hodnoty, vypsal
    // by si registr návrhů kdokoli přihlášený bez e-mailu — a v něm jsou názvy
    // staveb, jména firem a e-maily napříč všemi zákazníky.
    // ---------------------------------------------------------------------
    match /projectHandovers/{handoverId} {
      // Adresát čte svoje návrhy i výpisem (potřebuje je vidět v Hubu, než se
      // vůbec stane členem čehokoli). Navrhovatel čte JEN konkrétní návrh
      // (`get`, ne `list`) — výpis by dovolil enumeraci cizích návrhů.
      allow get: if isRealUser()
        && request.auth.token.get('email', '') != ''
        && (resource.data.get('toEmail', '') == request.auth.token.email
            || resource.data.get('fromEmail', '') == request.auth.token.email
            || resource.data.get('fromPrincipal', '') == principal());
      allow list: if isRealUser()
        && resource.data.toEmail == request.auth.token.email;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Veřejná konfigurace firmy (federační URL pro auto-discovery)
    //
    // `config/public` = { authExchangeUrl }. Zapisuje setup CLI (admin SDK /
    // REST s tokenem vlastníka, mimo rules). Čte se VEŘEJNĚ (i bez přihlášení),
    // aby si appka při připojení firmy doplnila URL token-exchange funkce sama —
    // bez ručního opisování z výstupu CLI. URL endpointu NENÍ tajná (autorizaci
    // dělá samotná funkce ověřením centrálního ID tokenu).
    // ---------------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // ROZHODNUTÍ JEDNOTLIVCE o testovacím provozu.
    //
    // Tři stavy, a chybějící dokument je ten třetí: `granted` · `declined` ·
    // **nerozhodnuto** (dokument neexistuje). Sbírá se JEN při `granted` —
    // dokud se člověk nevyjádří, nezaznamenává se nic. Fail-closed je tu
    // podstatný: mezi zapnutím provozu a odpovědí člověka může uběhnout den.
    //
    // 🔴 ČTE I PÍŠE VÝHRADNĚ TEN, KOHO SE TÝKÁ — ani vlastník firmy, ani
    // správce stavby. Obojí je záměr a obojí je nutné:
    //
    //  · ZÁPIS: kdyby rozhodnutí bydlelo v členském záznamu stavby
    //    (`workspaces/{wid}/projects/{pid}/members/{uid}`), přepsal by ho admin
    //    firmy, protože do toho dokumentu píše. Rozhodnutí člověka by pak
    //    platilo jen potud, pokud ho zaměstnavatel nechá platit.
    //  · ČTENÍ: seznam těch, kdo odmítli, je sám o sobě citlivý — kdo ho má,
    //    ví, na koho zatlačit. Balanční test v
    //    docs/legal/PRILOHA_TESTOVACI_PROVOZ.md §2 stojí na tom, že se firma
    //    k telemetrii ani k jejím metadatům nedostane; kdyby tohle četla,
    //    závěr testu padá.
    //
    // Vynucení sběru je klientské (kontrola PŘED zápisem) a serverové sweepy
    // jedou pod Admin SDK mimo pravidla — tahle cesta je pro člověka samotného.
    // ---------------------------------------------------------------------
    // ⚠️ JEDINÁ OBSAHOVÁ KOLEKCE POD STAVBOU BEZ ZMRAZENÍ, a je to záměr.
    // Rozhodnutí o testovacím provozu je právní úkon člověka, ne obsah stavby:
    // odvolat souhlas (`delete`) musí jít VŽDYCKY, i uprostřed předání —
    // blokovat odvolání by bylo horší než ztratit souhlas udělený během těch
    // pár minut. A ztráta udělení selhává bezpečně: bez záznamu se nesbírá nic
    // a systém se zeptá znovu.
    match /workspaces/{wid}/projects/{pid}/observationConsents/{who} {
      allow read: if isRealUser() && principal() == who;
      // Uzavřený tvar: rozhodnutí + verze znění + čas, nic jiného. Bez
      // `hasOnly` by si sem šlo uložit cokoli pod hlavičkou „souhlas".
      allow create, update: if isRealUser()
        && principal() == who
        && request.resource.data.keys().hasOnly(['decision', 'textVersion', 'at'])
        && request.resource.data.decision in ['granted', 'declined']
        && request.resource.data.textVersion is string
        && request.resource.data.at is string;
      // Smazání = návrat do „nerozhodnuto", tedy do stavu, kdy se NESBÍRÁ.
      // Nikomu tím nic nepřibude, tak není důvod ho zakazovat.
      allow delete: if isRealUser() && principal() == who;
    }

    // ---------------------------------------------------------------------
    // OPRÁVNĚNÍ OPERÁTORA — kdo smí do provozního přehledu (`/provoz`).
    //
    // 🔴 NEJCITLIVĚJŠÍ DOKUMENT V CELÉ DATABÁZI: uděluje pohled na VŠECHNY
    // zákazníky najednou. Zapisuje se výhradně mimo aplikaci
    // (`scripts/set-operator.mjs` pod účtem s Admin právy), čte ho jen
    // Cloud Function `operatorOverview` pod Admin SDK.
    //
    // Klient sem nesmí ani nahlédnout — kdo si vypíše seznam operátorů, ví,
    // na koho mířit sociálním inženýrstvím.
    //
    // ⚠️ Implicitní zákaz na konci souboru by to chytil taky (ověřeno testem).
    // Explicitní blok je tu pro případ, že sem někdo přidá širší `match`:
    // u dokumentu, který uděluje přístup k datům všech zákazníků, se nespoléhá
    // na to, že se na něj nezapomene.
    // ---------------------------------------------------------------------
    // ---------------------------------------------------------------------
    // ZÁZNAMY TESTOVACÍHO PROVOZU (telemetrie).
    //
    // Píše VÝHRADNĚ Cloud Function `recordObservationEvents` pod Admin SDK,
    // která si ověřuje zapnutí, členství i souhlas. Klient sem nesmí zapisovat
    // — `actor` je SHA-256 a pravidla ho neumí spočítat, takže by nedokázala
    // ověřit, že pseudonym patří volajícímu, ani že člověk souhlas neodvolal.
    //
    // 🔴 A NESMÍ ANI ČÍST — zvlášť ne firma. Balanční test i celá věta „záznam
    // neslouží k hodnocení lidí" stojí na tom, že se zákazník k telemetrii
    // nedostane. Kdyby ji admin firmy vypsal, je z toho nástroj kontroly
    // zaměstnanců a souhlas přestane být svobodný. Operátor ji čte přes Admin
    // SDK, ne odsud.
    // ---------------------------------------------------------------------
    match /observationEvents/{eventId} {
      allow read, write: if false;
    }

    match /operatorAccess/{who} {
      allow read, write: if false;
    }

    // Komu firma patří (obchodník). Server-only, jako `operatorAccess`.
    //
    // 🔴 SCHVÁLNĚ NE `workspaces/{wid}.acquiredBy`, jak navrhoval backlog. Tam
    // smí správce firmy zapsat libovolné pole (viz `allow update` výš, omezuje
    // jen `ownerId` a `adminIds`), takže by si zákazník sám zapsal, kdo ho
    // přivedl, a vyrobil tím provizi. Přesně to „šesté falšovatelné pole
    // s finančním dopadem" z docs/ai/fakturace-rozhodnuti.md §5.
    //
    // Zákazník to navíc ani nemá vidět — je to náš vnitřní obchodní údaj.
    match /operatorTenants/{wid} {
      allow read, write: if false;
    }

    // Výchozí podmínky provize. Server-only — sazba, kterou platíme
    // obchodníkovi, není věc zákazníka ani obchodníka samotného.
    match /operatorSettings/{docId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // Záznam o pohledech operátora do provozního přehledu (`/provoz`).
    //
    // Píše VÝHRADNĚ Cloud Function `operatorOverview` pod Admin SDK, tedy mimo
    // pravidla. Explicitní `if false` je tu i přes to, že by doc spadl pod
    // implicitní zákaz níž — má to dva důvody:
    //  1. je to auditní stopa nad vlastními zaměstnanci, takže „nesmí se do ní
    //     sáhnout z klienta" má být napsané, ne odvozené;
    //  2. kdyby sem někdo někdy přidal širší `match`, tenhle blok drží.
    //
    // ⚠️ ANI ČTENÍ. Kdo se díval do dat zákazníků je citlivější než většina
    // obsahu, který se tím prohlížel — a operátor si vlastní stopu číst
    // nepotřebuje (dělá se to Admin SDK, když se ptá auditor podle DPA čl. 14).
    // ---------------------------------------------------------------------
    match /operatorAccessLog/{entryId} {
      allow read, write: if false;
    }

    // No catch-all: everything else is denied by default.
  }
}
