rules_version = '2';

// Firemní úložiště souborů.
//
// AUTORIZACE PŘES CUSTOM CLAIMS (1. 8. 2026, docs/SECURITY_CLAIMS_DESIGN.md).
//
// Historie: od 22. 6. 2026 tu byl gate jen na „přihlášený skutečný uživatel".
// Původní verze gateovala per projekt přes cross-service `firestore.get()` a ta
// se ukázala jako NESPOLEHLIVÁ (403 i pro vlastníka). Zjednodušený gate držel,
// dokud měla KAŽDÁ FIRMA VLASTNÍ Firebase projekt — cizí firma prostě neměla
// kam sáhnout. Ve SDÍLENÉM tenantu (hostovaný model) ten předpoklad padá:
// „každý přihlášený uživatel" by znamenalo, že si kterýkoli zákazník přečte
// soubory kteréhokoli jiného, pokud zná cestu. Cesty jsou UUID, ale bezpečnost
// přes neuhodnutelnost cesty není bezpečnost.
//
// Řešení: členství nese SÁM TOKEN. Funkce `authExchange` (companion,
// `selfhost/functions/src/membershipClaims.ts`) spočítá členství z Firestore
// a orazí ho do custom claims:
//
//   wsa: [wid, …]              vlastník / admin firmy → všechny projekty té firmy
//   pw:  {wid: [pid, …], …}    oprávnění `edit` na projektu → plná práva
//   p:   {wid: [pid, …], …}    ostatní členství (contribute / read)
//                              → čtení + ZALOŽENÍ nového objektu
//   cv:  2                     verze TVARU claims (viz CLAIMS_VERSION)
//
// 📦 `p`/`pw` byly do 8/2026 PLOCHÉ seznamy `["{wid}/{pid}", …]`, které
// opakovaly `wid` u každého projektu. Hostovaný prostor má `wid` s prefixem
// `ws_` (23 znaků), takže se do tokenu vešlo jen 17 staveb a na 18. přestalo
// fungovat Storage (`docs/ai/token-ceiling-staging.md`, měřeno na stagingu).
// Seskupení podle firmy platí `wid` jednou za firmu → 34 staveb.
//
// ⭐ Claims zrcadlí `isProjectMember` z firestore.rules jedna ku jedné:
//     principal in projects/{pid}.memberIds || isWsAdmin(wid)
// Proto má `wsa` nevázané `pid` (admin firmy má i ve Firestore celý workspace),
// kdežto `p`/`pw` nesou konkrétní dvojici. Jakákoli odchylka od téhle symetrie
// je díra na jednu nebo druhou stranu.
//
// 🔴 Claim „zaměstnanec firmy" (`ws`) tu ZÁMĚRNĚ NENÍ. Odvozoval by se z
// existence `workspaces/{wid}/members/{principal}`, jenže ten dokument zakládá
// `redeemInvite` i HOSTOVI z cizí firmy. Host pozvaný na jednu stavbu by tak
// dostal všechny stavby té firmy. Podrobně v membershipClaims.ts.
//
// Oprávnění `contribute` (dnešní role viewer) smí obsah VYTVÁŘET — viz model
// v `src/lib/permissions/projectPermissions.ts` — takže musí umět nahrát fotku.
// Nesmí ale přepsat ani smazat cizí soubor —
// proto je `write` rozpadlý na `create` × `update, delete`.
//
// ⚠️ Claims žijí v tokenu, ne v databázi. Platnost Firebase ID tokenu je pevná
// 1 hodina a nejde zkrátit → okno zastaralosti až hodinu. Zmírnění (vynucená
// obnova, signální dokument `workspaces/{wid}/accessSignals/{principal}`,
// `revokeRefreshTokens`) je v kap. 3 návrhu a ve funkci `syncMemberClaims`.
// Firestore zůstává živou autoritou — tam je odebrání okamžité.

service firebase.storage {
  match /b/{bucket}/o {

    function isRealUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Chybějící claim čteme jako prázdný seznam — uživatel bez orazítkovaného
    // členství (starý token, selhaný exchange) nemá přístup nikam.
    function claim(name) {
      return request.auth.token.get(name, []);
    }

    // Vlastník / admin firmy — protějšek `isWsAdmin` z firestore.rules, který
    // taky platí na celý workspace bez ohledu na `pid`.
    function isWorkspaceAdmin(wid) {
      return wid in claim('wsa');
    }

    // Členské claims jsou MAPA `{wid: [pid, …]}`. Cestu si volí volající, takže
    // holé `pid` bez vazby na firmu by autorizovalo i
    // `workspaces/CIZI-FIRMA/projects/MUJ-PROJEKT/…` — psaní pod cizí prefix.
    // Klíč mapy JE workspace, takže tu vazbu drží sám tvar dat; dřív ji držela
    // jen konvence uvnitř řetězce `"{wid}/{pid}"`.
    //
    // ⚠️ PŘECHODNÁ VĚTEV. Firebase ID token platí pevnou hodinu a claims se
    // přepíšou až při přepočtu, takže po nasazení chvíli koluje starý PLOCHÝ
    // tvar. Bez téhle větve by v tom okně přišli o Storage všichni přihlášení.
    // Klient si podle `cv` přepočet vynutí (`refreshMembershipClaims`), takže
    // okno je krátké — až budou v provozu jen tokeny s `cv >= 2`, legacy část
    // odsud pryč (issue #569).
    //
    // Chybějící claim vrací `claim()` jako prázdný SEZNAM, takže se test typu
    // vyhodnotí na legacy větev a `'wid/pid' in []` je false. Fail-closed.
    function projectGrant(name, wid, pid) {
      return claim(name) is map
        ? pid in claim(name).get(wid, [])
        : (wid + '/' + pid) in claim(name);
    }

    // Člen projektu s právem zápisu (editor / admin).
    function projectWriteGrant(wid, pid) {
      return projectGrant('pw', wid, pid);
    }

    // Člen projektu bez práva mazat (contribute / read, tedy bez `edit`).
    function projectReadGrant(wid, pid) {
      return projectGrant('p', wid, pid);
    }

    function canReadProject(wid, pid) {
      return isRealUser()
        && (isWorkspaceAdmin(wid)
            || projectWriteGrant(wid, pid)
            || projectReadGrant(wid, pid));
    }

    // Přepsat/smazat existující objekt smí jen role s plným zápisem. Viewer
    // spadne do `canReadProject`, ale sem ne — svou fotku nahraje, cizí nesmaže.
    function canOverwriteProject(wid, pid) {
      return isRealUser()
        && (isWorkspaceAdmin(wid) || projectWriteGrant(wid, pid));
    }

    function withinSizeLimit() {
      return request.resource == null
        || request.resource.size < 200 * 1024 * 1024;
    }

    // Přímý Firebase download/upload interních firemních objektů je zakázaný.
    // Autorizaci i resumable upload zajišťuje companion Function `companyFile`.
    match /workspaces/{wid}/projects/{pid}/companySpaces/{companyId}/{rest=**} {
      allow read, write: if false;
    }

    // Projektové soubory firmy. Kategorie `companySpaces` je vyňatá, aby širší
    // pravidlo nemohlo přebít bezpečnou Function bránu výše (allow se mezi
    // souběžnými match bloky skládá pomocí OR).
    match /workspaces/{wid}/projects/{pid}/{category}/{rest=**} {
      allow read: if category != 'companySpaces' && canReadProject(wid, pid);

      // Rozdíl „nový objekt" × „sáhnutí na existující" schválně NEstavíme na
      // create/update/delete: upload přes existující cestu emulátor vyhodnocuje
      // jako `create`, takže by se přepis cizího souboru propašoval mezi
      // zakládání. `resource` (stav PŘED zápisem) je jednoznačný — null znamená,
      // že tam ještě nic není.
      allow write: if category != 'companySpaces'
        && withinSizeLimit()
        && (
          // Založení nového objektu — smí každý člen projektu včetně viewera.
          (resource == null && request.resource != null && canReadProject(wid, pid))
          // Přepis i smazání existujícího objektu — jen role s plným zápisem.
          || canOverwriteProject(wid, pid)
        );
    }

    // Připojovací probe a případné neprojektové objekty workspace. Jen
    // vlastník/admin firmy — nikdo jiný nemá jak prokázat příslušnost
    // k workspace jako celku. Probe (`__preflight__`) běží ve StorageSettings,
    // což je stejně obrazovka vlastníka.
    match /workspaces/{wid}/{objectName} {
      allow read: if isRealUser() && isWorkspaceAdmin(wid);
      allow write: if isRealUser() && isWorkspaceAdmin(wid) && withinSizeLimit();
    }
    match /workspaces/{wid}/{category}/{rest=**} {
      allow read: if category != 'projects' && isRealUser() && isWorkspaceAdmin(wid);
      allow write: if category != 'projects'
        && isRealUser()
        && isWorkspaceAdmin(wid)
        && withinSizeLimit();
    }

    // Vše ostatní (vč. legacy /projects/**) je zakázané.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
